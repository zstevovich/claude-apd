#!/bin/bash
# CC adapter shim for guard-bash-scope
# Reads Claude Code hook stdin JSON, passes normalized args to core
#
# The session-level hook has always been wired WITHOUT scope paths, so the core
# short-circuits (`ALLOWED_PATHS` empty → exit 0) right after its protected-path
# checks: the pipeline dir and the plugin cache were guarded, the agent's own
# write scope was not. The per-agent frontmatter hook that carried the paths
# never fired (measured, CC 2.1.220; on 2.1.259+ CC tries it and it fails to
# launch — see bin/lib/agent-scope.sh), so bash
# writes outside an agent's scope went unchecked.
#
# Resolution mirrors bin/adapter/cc/guard-scope: caller identified by
# `agent_type`, scope read from the registry, never from arguments.
#
# v7.1: the caller's identity is EXPORTED to the core, and the payload `cwd`
# is forwarded. Until now this shim read `agent_type` for scope resolution and
# dropped it on the floor, so every block the core logged read `orchestrator`
# — measured on one project: 166 of 170 September blocks were subagents, and
# the audit trail said the orchestrator did it. `cwd` is what a relative write
# target is relative to (the Bash tool's working directory persists across
# calls), which the core needs to resolve `cd sub && mv x y` correctly.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CORE_DIR="$SCRIPT_DIR/../../core"
LIB_DIR="$SCRIPT_DIR/../../lib"

if ! command -v jq &>/dev/null; then
  echo "ERROR: jq is not installed." >&2
  exit 2
fi

INPUT=$(cat)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
AGENT_TYPE=$(echo "$INPUT" | jq -r '.agent_type // empty' 2>/dev/null)
AGENT_ID=$(echo "$INPUT" | jq -r '.agent_id // empty' 2>/dev/null)
HOOK_CWD=$(echo "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
# The audit label is `${AGENT_ID:-orchestrator}(${AGENT_TYPE})` (style.sh
# log_block) — it can only be right if the core inherits both.
export AGENT_TYPE AGENT_ID

CWD_ARGS=()
[ -n "$HOOK_CWD" ] && CWD_ARGS=(--cwd "$HOOK_CWD")

# Legacy form: paths supplied by the caller (per-agent frontmatter).
if [ "$#" -gt 0 ]; then
  exec "$CORE_DIR/guard-bash-scope" --command "$COMMAND" ${CWD_ARGS[@]+"${CWD_ARGS[@]}"} "$@"
fi

# Orchestrator call, or a subagent APD does not own: run the core anyway so the
# protected-path checks (pipeline state, plugin cache) still apply — they are
# unconditional and do not depend on a scope list.
if [ -z "$AGENT_TYPE" ]; then
  exec "$CORE_DIR/guard-bash-scope" --command "$COMMAND" ${CWD_ARGS[@]+"${CWD_ARGS[@]}"}
fi

# shellcheck source=/dev/null
source "$LIB_DIR/resolve-project.sh"
[ "${APD_ACTIVE:-false}" = false ] && exit 0
# shellcheck source=/dev/null
source "$LIB_DIR/agent-scope.sh"

AGENT_FILE="$(_agent_def_file "$AGENT_TYPE" || true)"
if [ -z "$AGENT_FILE" ]; then
  exec "$CORE_DIR/guard-bash-scope" --command "$COMMAND" ${CWD_ARGS[@]+"${CWD_ARGS[@]}"}
fi

SCOPE_PATHS=()
while IFS= read -r p; do
  [ -n "$p" ] && SCOPE_PATHS+=("$p")
done < <(_agent_scope_paths "$AGENT_FILE")

# No declared scope → no writes through the shell, for EVERY agent in the
# registry. The session scratchpad stays open (the core's shared rule), and a
# command that writes nothing — `git diff`, the test command — is untouched.
#
# History, because this branch has been wrong twice. The first version fell
# through for everyone. The second (v7.0) failed closed only for an agent that
# carries Write/Edit in `tools:` and kept the fall-through for the review roles,
# on the reasoning that they "legitimately run `… > /tmp/out`" and are bounded
# elsewhere. They were not bounded anywhere on this channel: measured
# 2026-10-02, `echo x > src/…`, `rm -rf src/…` and `sed -i … src/…` all exited 0
# for code-reviewer, adversarial-reviewer and supervisor, while the same roles
# were refused on Write/Edit — the sanctioned channel guarded, the one beside it
# open, which is the exact shape the v7.0 comment called the worst of both.
# `permissionMode: plan` does not close it either: a subagent's mode is not
# honoured when the main session runs in auto mode.
#
# The cost is stated in the review templates: a reviewer's scratch output goes
# to the session scratchpad, not `/tmp`, and a mutation proof runs on a copy of
# the tree there, not in place.
#
# An agent's own memory directory is NOT opened on this channel. Passing it as
# the agent's scope was tried (audit-724 F3) and gave a review role every
# escape a scoped agent has (a symlink created inside the scope and written
# through, a program that names the scope and then writes elsewhere — pass 2).
# CC's memory feature writes through Write/Edit, which the guard-scope shim
# exempts; a shell write into the memory directory is refused (stated).
if [ ${#SCOPE_PATHS[@]} -eq 0 ]; then
  exec "$CORE_DIR/guard-bash-scope" --command "$COMMAND" ${CWD_ARGS[@]+"${CWD_ARGS[@]}"} --deny-all-writes
fi

exec "$CORE_DIR/guard-bash-scope" --command "$COMMAND" ${CWD_ARGS[@]+"${CWD_ARGS[@]}"} ${SCOPE_PATHS[@]+"${SCOPE_PATHS[@]}"}
