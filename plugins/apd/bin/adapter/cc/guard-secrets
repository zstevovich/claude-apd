#!/bin/bash
# CC adapter shim for guard-secrets
# Reads Claude Code hook stdin JSON, passes normalized args to core

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CORE_DIR="$SCRIPT_DIR/../../core"

if ! command -v jq &>/dev/null; then
  echo "ERROR: jq is not installed." >&2
  exit 2
fi

INPUT=$(cat)
# NotebookEdit names its target `notebook_path` and the `Write|Edit` matcher
# (a regex) matches it — see the note in guard-scope.
FILE_PATH=$(echo "$INPUT" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null)
COMMAND=$(echo "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)

exec "$CORE_DIR/guard-secrets" --file-path "$FILE_PATH" --command "$COMMAND" "$@"
