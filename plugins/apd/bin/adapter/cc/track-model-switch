#!/bin/bash
# CC adapter — PostModelSwitch hook shim (v7.2). Reads the hook JSON from stdin,
# extracts from_model/to_model and hands them to bin/core/track-model-switch.
# Observational: exits 0 whatever happens (jq missing, malformed payload).
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CORE_DIR="$SCRIPT_DIR/../../core"
INPUT=$(cat 2>/dev/null || true)
FROM=""; TO=""
if command -v jq >/dev/null 2>&1; then
  FROM=$(printf '%s' "$INPUT" | jq -r '.from_model // empty' 2>/dev/null || true)
  TO=$(printf '%s' "$INPUT" | jq -r '.to_model // empty' 2>/dev/null || true)
else
  FROM=$(printf '%s' "$INPUT" | sed -n 's/.*"from_model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  TO=$(printf '%s' "$INPUT" | sed -n 's/.*"to_model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi
bash "$CORE_DIR/track-model-switch" --from "$FROM" --to "$TO" || true   # no "$@": unbound under bash 3.2 with set -u when the hook passes no args
exit 0
