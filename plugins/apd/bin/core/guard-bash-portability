#!/bin/bash
# APD Bash Portability Guard — blocks commands that do not exist, or silently mean
# something else, on the platform you are actually running. SYMMETRIC since v6.38:
# on macOS it blocks GNU/Linux-isms, on Linux it blocks BSD/macOS-isms. Each block
# names the local equivalent.
#
# The Linux direction was missing until v6.38, and the gap was not academic: the
# framework is developed on macOS, so a BSD-ism reaches a Linux user unchallenged
# while the reverse is caught immediately. The worst of them is `sed -i ""` —
# valid and required on BSD, but on GNU the empty string is consumed as the
# SCRIPT, so the command succeeds and edits nothing. No error, wrong result.
#
# Root cause (2026-07-14 incident): an orchestrator used `timeout` (absent on macOS)
# to wrap a verifier re-run; it silently never started (command-not-found swallowed in
# the background) and the orchestrator believed the re-run had happened. The platform
# fact ("you are on Darwin") is in context but agents do not act on it — so the reliable
# lever is a hard guard, not another note.
#
# Interface: --command <cmd>
# Active when: APD_ACTIVE=true AND the platform is Darwin or Linux AND not opted out.
# Opt-out (genuine need, e.g. a wrapper that shims the command): APD_SKIP_PORTABILITY_GUARD=1
# Guard block: exit 2. Allow: exit 0. Inert on other platforms and non-APD projects.
#
# Note: this guard runs on the user's macOS, so its OWN matchers use POSIX ERE only
# (`[[:space:]]`, no `\s`/`\b`) to stay portable on BSD grep.

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
[ "$APD_ACTIVE" = false ] && exit 0
[ "${APD_SKIP_PORTABILITY_GUARD:-}" = "1" ] && exit 0
# OS gate. APD_PORTABILITY_FORCE is a TEST SEAM only: `darwin` / `linux` pick a
# direction so either side can be verified from either host (`1` = darwin, kept for
# compatibility with pre-v6.38 callers). It can only make the guard MORE strict.
case "${APD_PORTABILITY_FORCE:-}" in
  1|darwin) PLATFORM=Darwin ;;
  linux)    PLATFORM=Linux ;;
  *)        PLATFORM="$(uname -s)" ;;
esac
case "$PLATFORM" in
  Darwin|Linux) : ;;
  *) exit 0 ;;
esac

COMMAND=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --command) COMMAND="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[ -z "$COMMAND" ] && exit 0

# Command-position anchor: start-of-string, or right after a shell delimiter
# (; & | ( ` — which also covers && and ||), with an optional wrapper prefix
# (sudo/command/time timeout …). Keeps `gtimeout`, strings ("timeout"), comments,
# and substrings (candidate, --date) from false-matching.
POS='(^|[;&|(`])[[:space:]]*((sudo|command|time)[[:space:]]+)?'

# Heredoc bodies are DATA, not executed commands — a `cat <<EOF … nproc … EOF`
# that writes a Linux CI script must not trip the guard. Match against the command
# text with everything from the first heredoc operator stripped (M1).
CMD_EXEC="${COMMAND%%<<*}"

if [ "$PLATFORM" = "Darwin" ]; then
  _FOREIGN="a GNU/Linux-ism"; _HERE="Darwin/BSD userland, not Linux"
else
  _FOREIGN="a BSD/macOS-ism"; _HERE="Linux/GNU userland, not macOS"
fi

_block() { # <name> <alt-line>
  echo "BLOCKED: portability — \`$1\` is $_FOREIGN that does not work here." >&2
  echo "" >&2
  echo "  $2" >&2
  echo "" >&2
  echo "  You are on $_HERE. Run 'apd env' for the full table." >&2
  echo "  Genuinely need it (e.g. a coreutils shim)? Prefix: APD_SKIP_PORTABILITY_GUARD=1 <cmd>" >&2
  log_block "portability-$1" "$(printf '%s' "$COMMAND" | head -c 120)"
  exit 2
}

_match() { printf '%s' "$CMD_EXEC" | grep -qE "$1"; }

if [ "$PLATFORM" = "Darwin" ]; then

# --- Commands that DO NOT EXIST on macOS (unambiguous) ---
_match "${POS}timeout([[:space:]]|\$)" && \
  _block timeout 'No `timeout` on macOS. Use `gtimeout` (brew install coreutils), or run in the background and kill: ( cmd & p=\$!; sleep N; kill \$p 2>/dev/null ).'
_match "${POS}tac([[:space:]]|\$)" && \
  _block tac 'No `tac` on macOS. Use `tail -r`, or awk "{a[NR]=\$0} END{for(i=NR;i>=1;i--) print a[i]}".'
_match "${POS}nproc([[:space:]]|\$)" && \
  _block nproc 'No `nproc` on macOS. Use `sysctl -n hw.ncpu`.'

# --- Commands that EXIST but whose GNU flags are unsupported / different on BSD ---
_match "${POS}date([^;&|]*[[:space:]])(-d([[:space:]=]|\$)|--date)" && \
  _block 'date -d' 'GNU `date -d` is unsupported. Relative: `date -v-1d`. Parse a string: `date -j -f "%Y-%m-%d" "2020-01-01"`.'
_match "${POS}stat([^;&|]*[[:space:]])-c([[:space:]=%'\"]|\$)" && \
  _block 'stat -c' 'GNU `stat -c` is unsupported. Use `stat -f` (BSD, different specifiers: `%z` size, `%m` mtime).'
_match "${POS}grep([^;&|]*[[:space:]])(-[a-zA-Z]*P([[:space:]]|\$)|--perl-regexp)" && \
  _block 'grep -P' 'BSD grep has no `-P` (PCRE). Use `grep -E` for extended regex, or `perl -ne` / `pcre2grep` for PCRE.'
_match "${POS}readlink([^;&|]*[[:space:]])-[a-zA-Z]*f([[:space:]]|\$)" && \
  _block 'readlink -f' 'BSD `readlink -f` differs. Use `realpath` (present on modern macOS) or a resolve loop.'
_match "${POS}find([^;&|]*[[:space:]])-printf([[:space:]]|\$)" && \
  _block 'find -printf' 'BSD find has no `-printf`. Use `-exec stat -f ...` or `-exec printf ...`.'

# --- sed --in-place (GNU long form): BSD sed has no such flag at all → always breaks ---
_match "${POS}sed([^;&|]*[[:space:]])--in-place" && \
  _block 'sed -i' 'BSD sed has no `--in-place`. Use `sed -i "" "s/a/b/"` (empty backup arg) or `sed -i.bak "s/a/b/"`.'

# --- sed -i: BSD REQUIRES a backup-suffix arg; GNU form (script right after -i) breaks ---
# Block `sed … -i <script>` (nonempty quoted script, or an unquoted s///|y///|<addr>d
# form directly after -i). PASS the BSD-correct `-i ''` / `-i ""` / `-i.bak`.
_match "${POS}sed([^;&|]*[[:space:]])-i[[:space:]]+(['\"][^'\"]|[0-9]*[sy]/|[0-9]*[,\$]*[dpg])" && \
  _block 'sed -i' 'BSD `sed -i` REQUIRES a backup-suffix arg: `sed -i "" "s/a/b/"` (empty) or `sed -i.bak "s/a/b/"`. GNU `sed -i "s/a/b/"` errors/deletes here.'

else

# ===== Linux / GNU userland: block BSD-only forms =====

# The mirror of the macOS `sed -i <script>` check, and the most dangerous entry
# in either direction: on GNU the empty string is consumed as the SCRIPT, so the
# command exits 0 and edits nothing. Silent no-op, not an error.
_match "${POS}sed([^;&|]*[[:space:]])-i[[:space:]]+(''|\"\")([[:space:]]|\$)" && \
  _block 'sed -i ""' 'GNU `sed -i` takes NO separate backup arg — the empty string is read as the script and your edit silently does nothing. Use `sed -i "s/a/b/"`, or `sed -i.bak "s/a/b/"` which works on both.'

# GNU `stat -f` is --file-system: it prints filesystem stats and exits 0, so a
# `stat -f %m file` reads as success and returns the wrong thing.
_match "${POS}stat([^;&|]*[[:space:]])-f([[:space:]=%'\"]|\$)" && \
  _block 'stat -f' 'On GNU, `stat -f` means --file-system (not a format string) — it succeeds and returns the wrong data. Use `stat -c` (`%Y` mtime, `%s` size).'

_match "${POS}date([^;&|]*[[:space:]])-v([[:space:]+-]|\$)" && \
  _block 'date -v' 'GNU date has no `-v`. Relative dates: `date -d "-1 day"`.'
_match "${POS}date([^;&|]*[[:space:]])-j([[:space:]]|\$)" && \
  _block 'date -j' 'GNU date has no `-j`. Parse a string with `date -d "2020-01-01"`.'
# BSD `date -r 1700000000` = epoch; GNU `-r` = reference FILE, so this fails or
# reads an unrelated file's mtime.
_match "${POS}date([^;&|]*[[:space:]])-r[[:space:]]*[0-9]" && \
  _block 'date -r <epoch>' 'On GNU, `date -r` takes a FILE, not an epoch. Use `date -d "@1700000000"`.'

_match "${POS}tail([^;&|]*[[:space:]])-[a-zA-Z]*r([[:space:]]|\$)" && \
  _block 'tail -r' 'GNU tail has no `-r`. Use `tac`.'
_match "${POS}md5([[:space:]]|\$)" && \
  _block md5 'No `md5` on Linux. Use `md5sum` (note: it prints "<hash>  <file>").'
_match "${POS}base64([^;&|]*[[:space:]])-D([[:space:]]|\$)" && \
  _block 'base64 -D' 'GNU base64 decodes with `-d`, not `-D`.'
_match "${POS}sysctl([^;&|]*[[:space:]])-n[[:space:]]+hw\." && \
  _block 'sysctl hw.*' 'Darwin-only sysctl MIB. CPU count on Linux: `nproc`.'
_match "${POS}find([^;&|]*[[:space:]])-E([[:space:]]|\$)" && \
  _block 'find -E' 'BSD `find -E` (extended regex) does not exist on GNU. Use `find -regextype posix-extended`.'

fi

exit 0
