#!/bin/bash
# APD Orchestrator Guard — prevents the orchestrator from writing code files directly
# Agents have agent_id; orchestrator does not.
# If no agent_id → this is the orchestrator → block code file writes.
#
# One list of code extensions for every stack (see below).
# Interface: --file-path <path> --agent-id <id>

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
source "$(dirname "$0")/../lib/path-canon.sh"
[ "$APD_ACTIVE" = false ] && exit 0

FILE_PATH=""
AGENT_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file-path) FILE_PATH="$2"; shift 2 ;;
    --agent-id)  AGENT_ID="$2"; shift 2 ;;
    *) shift ;;
  esac
done

# If this is an agent (has agent_id), allow — agents have their own guard-scope
if [ -n "$AGENT_ID" ]; then
  exit 0
fi

# No agent_id = orchestrator session
if [ -z "$FILE_PATH" ]; then
  exit 0
fi

# v7.1.4: the session scratchpad is sanctioned for the orchestrator too — a
# helper script there is not production code. The bash guard has allowed it
# since v7.0.5; this guard judged the extension of whatever was left after
# stripping the project prefix, so an absolute scratchpad path kept its `.sh`
# and was refused (reported and reproduced 2026-09-30).
_ABS_PATH=$(_canon_abs "$FILE_PATH")
_is_session_scratchpad "$_ABS_PATH" && exit 0

REL_PATH="${FILE_PATH#"$PROJECT_DIR"/}"

# Always allow: APD infrastructure, config, documentation
case "$REL_PATH" in
  .claude/*|CLAUDE.md|.gitignore|*.md|docs/*|.apd-*|.env*|*.json|*.yaml|*.yml|*.toml|*.xml|*.lock)
    exit 0
    ;;
esac

# Code extensions: ONE list, whatever the stack (v7.2.4).
#
# Until v7.2.3 the list was narrowed by STACK, read from the userConfig option
# first — one value per USER, so a `nodejs` option left over from another
# project let the orchestrator write `.cs` files in a .NET repo. Reading the
# project's config first fixed that and exposed the real flaw (audit-724 R1):
# a narrowed list is wrong for every project with more than one language
# (a KMP project's iOS `.swift`, an Android NDK's `.cpp`/`.h`, a .NET backend's
# React `.tsx`), and a stack value outside the case list (`kmp`, `kotlin`) had
# silently been the SAFE one because it fell to the full list. The orchestrator
# writes no code in any language, so the list does not depend on the stack.
#
# It covers source code, shell and SQL, build scripts and project files (a
# `.kts`/`.gradle` build, MSBuild `.csproj`/`.props`/`.targets`), stylesheets,
# HTML and server-side templates — what workflow.md says the orchestrator never
# writes. Matched case-insensitively (`Foo.CS` is code). Data-format files
# (`.json`, `.yaml`, `.toml`, `.xml`) stay allowed above on purpose: APD's own
# config and the tool configs the orchestrator maintains live in them.
CODE_EXT="php|phtml|js|jsx|ts|tsx|mjs|cjs|mts|cts|vue|svelte|astro|coffee|py|pyi|ipynb|rb|erb|go|rs|java|kt|kts|scala|groovy|gradle"
CODE_EXT="${CODE_EXT}|cs|fs|vb|razor|cshtml|xaml|csproj|fsproj|vbproj|props|targets|sln|c|cc|cpp|h|hpp|m|mm|swift|dart|lua|pl|ex|exs|r|jl"
CODE_EXT="${CODE_EXT}|sh|bash|zsh|ps1|psm1|bat|cmd|sql|prisma|proto|graphql|tf|cmake|mk"
CODE_EXT="${CODE_EXT}|css|scss|sass|less|html|htm|twig|ejs|hbs|jinja|j2|njk|pug|liquid"

# Build files with no extension to match
_IS_DOCKERFILE=false
case "$(basename "$REL_PATH" | tr '[:upper:]' '[:lower:]')" in
  dockerfile|dockerfile.*|*.dockerfile|containerfile|containerfile.*|makefile|gnumakefile|jenkinsfile|rakefile|gemfile|podfile|vagrantfile|justfile) _IS_DOCKERFILE=true ;;
esac

if [ "$_IS_DOCKERFILE" = true ] || echo "$REL_PATH" | grep -qiE "\.(${CODE_EXT})$"; then
  echo "BLOCKED: Orchestrator cannot write code files directly." >&2
  echo "  File: $REL_PATH" >&2
  echo "  Dispatch the appropriate Builder agent instead." >&2
  echo "" >&2
  echo "  Available agents:" >&2
  if [ -d "$APD_AGENTS_DIR" ]; then
    for agent_file in "$APD_AGENTS_DIR"/*.md; do
      [ -f "$agent_file" ] || continue
      AGENT_NAME=$(basename "$agent_file" .md)
      echo "    - $AGENT_NAME" >&2
    done
  fi
  log_block "orchestrator-code-write" "$REL_PATH"
  exit 2
fi

# Allow everything else (data files, images, …)
exit 0
