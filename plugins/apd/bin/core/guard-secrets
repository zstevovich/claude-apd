#!/bin/bash
# APD Secrets Guard — prevents access to sensitive files
# Customize BLOCKED_PATTERNS for your project
#
# Interface: --file-path <path> --command <cmd>

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
[ "$APD_ACTIVE" = false ] && exit 0

FILE_PATH=""
COMMAND=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file-path) FILE_PATH="$2"; shift 2 ;;
    --command)   COMMAND="$2"; shift 2 ;;
    *) shift ;;
  esac
done

# ===== CUSTOMIZE FOR YOUR PROJECT =====
# Two classes, because they need different matching.
#
# SECRET_NAMES are distinctive enough to match anywhere in a path or a command
# line: nothing else in a repository is called `id_rsa`.
BLOCKED_PATTERNS=(
  # Environment files
  '.env.production'
  '.env.staging'
  '.env.prod'
  # Keys and certificates
  'id_rsa'
  'id_ed25519'
  'id_ecdsa'
  # Credential files
  'credentials.json'
  'service-account'
  '.sa.json'
  # Docker registry
  '.docker/config.json'
  # .NET specific (remove if not .NET)
  'appsettings.Production.json'
  'appsettings.Staging.json'
  'user-secrets'
)

# SECRET_EXTENSIONS are matched as dot-delimited components of a FILENAME, not
# as substrings. `.key` as a substring is the guard's worst false positive:
# `jq -r '.key'`, `data.keys()`, `grep -rn "api.keys"` are all ordinary and all
# blocked by it. As a component the rule reads the way a human does — `foo.key`
# is a key file, `data.keys` is not — and a bare `.key` token in a command is
# treated as a selector rather than a filename (in a FILE PATH it is a file, so
# there it still blocks).
#
# `keystore`/`jks`/`p12` are listed explicitly: they used to be caught only by
# accident, as substrings of `.key`, and the component rule would have dropped
# them silently. Stating them keeps the coverage and makes the intent visible.
SECRET_EXTENSIONS=(pem key pfx p12 jks keystore)
# =======================================

# Does a path's FILENAME carry a secret extension as a dot component?
# $2 = "path" (a leading-dot name like `.key` IS a file) or "token" (a bare
# `.key` in a command line is a jq filter far more often than a filename).
# Written with parameter expansion rather than `IFS=. read` or a `for` over an
# unquoted split: both would glob-expand a token like `*.key` against the
# working directory, and a filename containing a space would be split into
# words — `my key.txt` would resolve a component `key` and block.
_ext_hit() {
  local base="${1##*/}" mode="$2" rest part ext
  case "$base" in *.*) ;; *) return 1 ;; esac
  [ -z "${base%%.*}" ] && [ "$mode" = token ] && return 1   # bare `.key`
  rest="${base#*.}"
  while :; do
    part="${rest%%.*}"
    for ext in "${SECRET_EXTENSIONS[@]}"; do
      [ "$part" = "$ext" ] && return 0
    done
    case "$rest" in *.*) rest="${rest#*.}" ;; *) break ;; esac
  done
  return 1
}

_secret_block() {
  echo "BLOCKED: Access to sensitive file: $1" >&2
  log_block "secret-access" "$1"
  exit 2
}

if [ -n "$FILE_PATH" ]; then
  # Check the path as given AND as resolved. Without the second form a symlink
  # named innocently — `config/local.json` -> `.env.production` — reads the
  # secret through a name that matches nothing. Canonicalise the parent so a
  # file that does not exist yet still resolves.
  CANDIDATES=("$FILE_PATH")
  if command -v realpath >/dev/null 2>&1; then
    RESOLVED=$(realpath "$FILE_PATH" 2>/dev/null || true)
  else
    RESOLVED=""
  fi
  if [ -z "$RESOLVED" ]; then
    FP_DIR=$(dirname "$FILE_PATH")
    FP_DIR_ABS="$(cd "$FP_DIR" 2>/dev/null && pwd -P || true)"
    [ -n "$FP_DIR_ABS" ] && RESOLVED="$FP_DIR_ABS/$(basename "$FILE_PATH")"
  fi
  [ -n "$RESOLVED" ] && [ "$RESOLVED" != "$FILE_PATH" ] && CANDIDATES+=("$RESOLVED")

  for candidate in "${CANDIDATES[@]}"; do
    REL_PATH="${candidate#"$PROJECT_DIR"/}"
    for pattern in "${BLOCKED_PATTERNS[@]}"; do
      [[ "$REL_PATH" == *"$pattern"* ]] && _secret_block "$REL_PATH"
    done
    _ext_hit "$REL_PATH" path && _secret_block "$REL_PATH"
  done
fi

if [ -n "$COMMAND" ]; then
  # Distinctive names stay a whole-command substring check — no loosening.
  for pattern in "${BLOCKED_PATTERNS[@]}"; do
    if [[ "$COMMAND" == *"$pattern"* ]]; then
      echo "BLOCKED: Command accesses sensitive file: $pattern" >&2
      log_block "secret-access" "$pattern"
      exit 2
    fi
  done
  # Extensions are judged per token, so shell syntax cannot glue an extension
  # onto an unrelated word and quotes do not hide one.
  # `|| [ -n "$token" ]` is load-bearing: without a trailing newline `read`
  # returns non-zero on the LAST token and the loop body never runs for it —
  # and the last token of a command is usually the file. `cat certs/server.pem`
  # passed clean until a matrix case caught it.
  while IFS= read -r token || [ -n "$token" ]; do
    [ -n "$token" ] || continue
    if _ext_hit "$token" token; then
      echo "BLOCKED: Command accesses sensitive file: $token" >&2
      log_block "secret-access" "$token"
      exit 2
    fi
  done < <(printf '%s' "$COMMAND" | tr -s '\042\047\140|;&()<>$ \t' '\n')
fi

exit 0
