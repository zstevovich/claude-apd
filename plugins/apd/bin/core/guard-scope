#!/bin/bash
# APD Scope Guard — blocks Write/Edit operations outside the allowed scope
# Interface: --file-path <path> <allowed_path_1> <allowed_path_2> ...

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
[ "$APD_ACTIVE" = false ] && exit 0

FILE_PATH=""
ALLOWED_PATHS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file-path) FILE_PATH="$2"; shift 2 ;;
    *) ALLOWED_PATHS+=("$1"); shift ;;
  esac
done

if [ ${#ALLOWED_PATHS[@]} -eq 0 ]; then
  exit 0
fi

if [ -z "$FILE_PATH" ]; then
  exit 0
fi

# Canonicalize the path so `src/../../escape/foo` cannot slip past a prefix
# match on `src/`, and canonicalize PROJECT_DIR the same way before stripping
# the prefix (physical vs logical form — the v6.37.1 symlink fix; the v7.0.4
# first-file-in-a-new-directory fix). v7.1: both live in bin/lib/path-canon.sh,
# shared with guard-bash-scope so the two write channels agree on what "inside
# the scope" means. Anything the normalizer could not resolve still carries its
# `..`, and the traversal check below catches it.
source "$(dirname "$0")/../lib/path-canon.sh"
ABS_PATH=$(_canon_abs "$FILE_PATH")
PROJ_CANON=$(_proj_canon)
REL_PATH="${ABS_PATH#"$PROJ_CANON"/}"

# Defense in depth: even if normalization failed, reject any path segment
# that still contains `..` (unresolved traversal means we can't trust the
# prefix match below).
case "/$REL_PATH/" in
  */../*|*/..|../*)
    echo "BLOCKED: File $FILE_PATH contains unresolved path traversal." >&2
    log_block "path-traversal" "$FILE_PATH"
    exit 2
    ;;
esac

if [[ "$REL_PATH" == /* ]]; then
  echo "BLOCKED: File $FILE_PATH is outside the project directory." >&2
  echo "Allowed paths: ${ALLOWED_PATHS[*]}" >&2
  log_block "out-of-scope-write" "$REL_PATH"
  exit 2
fi

# v7.0.5: agent memory is writable by any agent, regardless of code scope.
# `.claude/agent-memory/<agent>/` exists so an agent can carry a lesson from one
# dispatch to the next; that is not code and it is not covered by a code scope.
# It appeared to work for years only because per-agent frontmatter hooks never
# fired on CC — the moment v7.0 wired guard-scope session-level, the directory
# became unwritable and four blocks landed in a single PLAZMA run. The rest of
# `.claude/` stays protected: only this subtree is exempt.
case "$REL_PATH" in
  .claude/agent-memory/*|*/.claude/agent-memory/*) exit 0 ;;
esac

for allowed in "${ALLOWED_PATHS[@]}"; do
  allowed="${allowed%/}/"
  # Slash on BOTH sides (same idiom as guard-bash-scope / pipeline-gate):
  # a scope entry may be a single FILE (Dockerfile) — "Dockerfile/" must match
  # "Dockerfile/" exactly — while "Dockerfile.evil/" and "src-evil/" still
  # fail the prefix, keeping the collision defence intact.
  if [[ "$REL_PATH/" == "$allowed"* ]]; then
    exit 0
  fi
done

echo "BLOCKED: File $REL_PATH is outside the allowed scope." >&2
echo "Allowed paths: ${ALLOWED_PATHS[*]}" >&2
log_block "out-of-scope-write" "$REL_PATH"
exit 2
