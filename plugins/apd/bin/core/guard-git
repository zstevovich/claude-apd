#!/bin/bash
# APD Guard — blocks unauthorized git operations
# Subagents must not commit, push, or perform destructive operations
#
# Interface: --command <cmd> --agent-id <id> --agent-type <type>
#
# The compiled guard (apd-guard git, source in guard/ of the APD repository)
# reads the command with a shell parser and judges every git STATEMENT in it:
# `grep -rn "git commit" src/` and a commit message that mentions `--force` are
# data, `sh -c "git commit"`, `sudo git push` and `git -C dir commit` are the
# statements they are. This script resolves the project, runs the judge, and —
# for a commit the orchestrator signed — runs the pipeline gate and the
# project's verification before letting it through.

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/apd-guard.sh"
[ "$APD_ACTIVE" = false ] && exit 0

COMMAND=""
AGENT_ID=""
AGENT_TYPE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --command)    COMMAND="$2"; shift 2 ;;
    --agent-id)   AGENT_ID="$2"; shift 2 ;;
    --agent-type) AGENT_TYPE="$2"; shift 2 ;;
    *) shift ;;
  esac
done

# Log function — logs blocked actions with agent context. guard-git carries
# its own (it does not source style.sh) and records the whole command; it
# mirrors the _audit_type() contract so verify-apd's guard-coverage blocks are
# tagged SYNTHETIC, not BLOCK.
log_block() {
  local reason="$1"
  local log_file="$MEMORY_DIR/guard-audit.log"
  if [ -d "$MEMORY_DIR" ]; then
    local agent_info="${AGENT_ID:-orchestrator}"
    [ -n "$AGENT_TYPE" ] && agent_info="${agent_info}(${AGENT_TYPE})"
    # Collapse newlines/CR so each event is exactly one log line
    local cmd="$COMMAND"
    cmd="${cmd//$'\n'/ }"
    cmd="${cmd//$'\r'/ }"
    local log_type="BLOCK"
    [ "${APD_AUDIT_SYNTHETIC:-}" = "1" ] && log_type="SYNTHETIC"
    echo "$(date +%Y-%m-%d\ %H:%M:%S)|${log_type}|${agent_info}|${reason}|${cmd}" >> "$log_file" 2>/dev/null
  fi
}

[ -z "$COMMAND" ] && exit 0
_apd_guard_require guard-git

_block() {  # <reason> <message lines...>
  local reason="$1"; shift
  local l; for l in "$@"; do echo "$l" >&2; done
  log_block "$reason"
  exit 2
}

OUT=$("$APD_GUARD_BIN" git --command "$COMMAND" --agent-type "$AGENT_TYPE" 2>&1); RC=$?
if [ "$RC" -eq 2 ]; then
  # `<reason>: BLOCKED: <message>`
  _block "${OUT%%: *}" "${OUT#*: }"
fi
# exit 0 is an answer only together with the judge's own word (`ok`, or `commit`
# for a signed commit): an empty file at the binary's path exits 0 having judged nothing
[ "$RC" -eq 0 ] && [ "$OUT" = ok ] && exit 0
{ [ "$RC" -eq 0 ] && [ "$OUT" = commit ]; } || _apd_guard_failed guard-git "$RC" "$OUT"

# A signed commit that the judge let through: pipeline gate + project verification.
#
# Both run inside this hook, and Claude Code cancels a hook at its time limit
# (30 s in hooks.json) and then RUNS the call — a gate that is still working at
# that moment has let the commit through. So everything below answers before
# the limit: each stage runs bounded, and a stage that does not finish REFUSES.
# The verification itself is skipped when the tree is the one the verifier step
# already verified with this same script (lib/verified-tree.sh); when it is not,
# it runs here only as long as the budget allows.
source "$(dirname "$0")/../lib/verified-tree.sh"
_CG_SEC="${APD_COMMIT_GATE_SEC:-22}"
case "$_CG_SEC" in ''|*[!0-9]*) _CG_SEC=22 ;; esac
[ "$_CG_SEC" -gt 25 ] && _CG_SEC=25
_CG_OUT=$(mktemp "${TMPDIR:-/tmp}/apd-cg.XXXXXX" 2>/dev/null) || _CG_OUT=""
[ -n "$_CG_OUT" ] || { _CG_OUT="$PIPELINE_DIR/.commit-gate.out"; : > "$_CG_OUT" 2>/dev/null || _CG_OUT=/dev/null; }
_cg_done() { [ "$_CG_OUT" != /dev/null ] && rm -f "$_CG_OUT" 2>/dev/null; rm -rf "${TMPDIR:-/tmp}"/apd-vt.$$.* 2>/dev/null; return 0; }
trap _cg_done EXIT
_cg_show() { [ -s "$_CG_OUT" ] && cat "$_CG_OUT" >&2; return 0; }
_cg_timeout() {  # <what did not finish> <what to do, lines…>
  local what="$1"; shift
  _cg_show
  echo "" >&2
  echo "BLOCKED: $what did not finish in ${_CG_SEC}s. Commit rejected." >&2
  echo "  Claude Code cancels this hook at its time limit and then runs the commit" >&2
  echo "  unjudged, so the guard refuses instead of being cancelled." >&2
  local l; for l in "$@"; do echo "$l" >&2; done
  log_block "commit-gate-timeout"
  exit 2
}

# 1. Pipeline gate
if [ -x "$SCRIPT_DIR/pipeline-gate" ]; then
  _vt_bounded "$_CG_SEC" "$_CG_OUT" bash "$SCRIPT_DIR/pipeline-gate"; _rc=$?
  [ "$_rc" -eq 124 ] && _cg_timeout "The pipeline gate" \
    "  Run it by hand to see where it stops: bash $SCRIPT_DIR/pipeline-gate"
  _cg_show
  if [ "$_rc" -ne 0 ]; then
    echo "" >&2
    _block "pipeline-incomplete" "BLOCKED: Pipeline steps are not completed. Commit rejected."
  fi
fi
# 2. Verification (build + lint + test) — verify-all.sh lives in the PROJECT
if [ -x "$CLAUDE_DIR/scripts/verify-all.sh" ]; then
  _vt_bounded "$_CG_SEC" "$_CG_OUT" _vt_fingerprint; _rc=$?
  _fp=""; [ "$_rc" -eq 0 ] && _fp=$(head -1 "$_CG_OUT" 2>/dev/null)
  if _vt_record_ok && [ "$_fp" = "$(_vt_recorded_fp)" ] \
     && [ "$(_vt_script_id "$CLAUDE_DIR/scripts/verify-all.sh")" = "$(_vt_recorded_script)" ]; then
    echo "-> Verification holds: the tree is the one the verifier step passed." >&2
  else
    echo "-> Running pre-commit verification..." >&2
    _vt_bounded "$_CG_SEC" "$_CG_OUT" bash "$CLAUDE_DIR/scripts/verify-all.sh"; _rc=$?
    [ "$_rc" -eq 124 ] && _cg_timeout "The verification" \
      "  The working tree is not the one the verifier step verified (a file changed" \
      "  after it, or there is no record), and the verification does not fit here." \
      "  Run the verifier step again — it has no time limit and records the tree:" \
      "    bash $APD_SHORTCUT_DISPLAY pipeline verifier" \
      "  then commit without changing a file in between (git add is fine)."
    _cg_show
    if [ "$_rc" -ne 0 ]; then
      _block "verify-failed" "BLOCKED: Verification failed. Commit rejected."
    fi
  fi
fi
# Pipeline reset happens in PostToolUse hook (pipeline-post-commit)
# — only AFTER a successful commit, not before
echo "Pipeline + Verification passed — commit allowed." >&2
exit 0
