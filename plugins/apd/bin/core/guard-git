#!/bin/bash
# APD Guard — blocks unauthorized git operations
# Subagents must not commit, push, or perform destructive operations
#
# Interface: --command <cmd> --agent-id <id> --agent-type <type>
#
# The compiled guard (apd-guard git, source in guard/ of the APD repository)
# reads the command with a shell parser and judges every git STATEMENT in it:
# `grep -rn "git commit" src/` and a commit message that mentions `--force` are
# data, `sh -c "git commit"`, `sudo git push` and `git -C dir commit` are the
# statements they are. This script resolves the project, runs the judge, and —
# for a commit the orchestrator signed — runs the pipeline gate and the
# project's verification before letting it through.

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/apd-guard.sh"
[ "$APD_ACTIVE" = false ] && exit 0

COMMAND=""
AGENT_ID=""
AGENT_TYPE=""
ARGS=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --command)    COMMAND="$2"; shift 2 ;;
    --agent-id)   AGENT_ID="$2"; shift 2 ;;
    --agent-type) AGENT_TYPE="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ "${APD_GUARD_ENGINE:-}" = bash ]; then
  exec bash "$0.bash" ${ARGS[@]+"${ARGS[@]}"}
fi

# Log function — logs blocked actions with agent context. guard-git carries
# its own (it does not source style.sh) and records the whole command; it
# mirrors the _audit_type() contract so verify-apd's guard-coverage blocks are
# tagged SYNTHETIC, not BLOCK.
log_block() {
  local reason="$1"
  local log_file="$MEMORY_DIR/guard-audit.log"
  if [ -d "$MEMORY_DIR" ]; then
    local agent_info="${AGENT_ID:-orchestrator}"
    [ -n "$AGENT_TYPE" ] && agent_info="${agent_info}(${AGENT_TYPE})"
    # Collapse newlines/CR so each event is exactly one log line
    local cmd="$COMMAND"
    cmd="${cmd//$'\n'/ }"
    cmd="${cmd//$'\r'/ }"
    local log_type="BLOCK"
    [ "${APD_AUDIT_SYNTHETIC:-}" = "1" ] && log_type="SYNTHETIC"
    echo "$(date +%Y-%m-%d\ %H:%M:%S)|${log_type}|${agent_info}|${reason}|${cmd}" >> "$log_file" 2>/dev/null
  fi
}

[ -z "$COMMAND" ] && exit 0
_apd_guard_require guard-git

_block() {  # <reason> <message lines...>
  local reason="$1"; shift
  local l; for l in "$@"; do echo "$l" >&2; done
  log_block "$reason"
  exit 2
}

OUT=$("$APD_GUARD_BIN" git --command "$COMMAND" --agent-type "$AGENT_TYPE" 2>&1); RC=$?
if [ "$RC" -eq 2 ]; then
  # `<reason>: BLOCKED: <message>`
  _block "${OUT%%: *}" "${OUT#*: }"
fi
# exit 0 is an answer only together with the judge's own word (`ok`, or `commit`
# for a signed commit): an empty file at the binary's path exits 0 having judged nothing
[ "$RC" -eq 0 ] && [ "$OUT" = ok ] && exit 0
{ [ "$RC" -eq 0 ] && [ "$OUT" = commit ]; } || _apd_guard_failed guard-git "$RC" "$OUT"

# A signed commit that the judge let through: pipeline gate + project verification
# 1. Pipeline gate
if [ -x "$SCRIPT_DIR/pipeline-gate" ]; then
  if ! bash "$SCRIPT_DIR/pipeline-gate" >&2; then
    echo "" >&2
    _block "pipeline-incomplete" "BLOCKED: Pipeline steps are not completed. Commit rejected."
  fi
fi
# 2. Verification (build + lint + test) — verify-all.sh lives in the PROJECT
if [ -x "$CLAUDE_DIR/scripts/verify-all.sh" ]; then
  echo "-> Running pre-commit verification..." >&2
  if ! bash "$CLAUDE_DIR/scripts/verify-all.sh" >&2; then
    _block "verify-failed" "BLOCKED: Verification failed. Commit rejected."
  fi
fi
# Pipeline reset happens in PostToolUse hook (pipeline-post-commit)
# — only AFTER a successful commit, not before
echo "Pipeline + Verification passed — commit allowed." >&2
exit 0
