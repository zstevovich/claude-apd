#!/bin/bash
# APD SendMessage Guard — blocks SendMessage during active pipeline
#
# SendMessage continues an EXISTING agent. Measured 2026-10-01 on CC 2.1.286: that
# continuation fires SubagentStart again with the same agent id (and one stop at the
# end); since v7.2 track-agent records it as `resume`, not as a dispatch. Either way
# a pipeline step needs a FRESH Agent() dispatch: a continued agent is not a new
# builder/reviewer run, the budget does not count it, and pipeline-advance treats a
# re-started agent as running (its earlier stop is no longer evidence). The block
# stands — in a pipeline, dispatch a new agent.

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
[ "$APD_ACTIVE" = false ] && exit 0

# Only block when pipeline is active (spec.done exists)
if [ -f "$PIPELINE_DIR/spec.done" ]; then
    echo "BLOCKED: Do not use SendMessage during an active pipeline." >&2
    echo "" >&2
    echo "  SendMessage continues an existing agent — the ledger records a resume, not a dispatch." >&2
    echo "  pipeline-advance treats a re-started agent as running and will not count it as a step." >&2
    echo "" >&2
    echo "  Instead, dispatch a NEW agent:" >&2
    echo "    Agent({ subagent_type: \"agent-name\", prompt: \"...\" })" >&2
    log_block "send-message-during-pipeline"
    exit 2
fi

exit 0
