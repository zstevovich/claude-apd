#!/bin/bash
# APD Spec-Blind Guard — enforces the adversarial reviewer's decontextualisation
#
# WHY THIS EXISTS
# The adversarial reviewer's value is positional: it judges the diff without
# knowing the intent behind it. The role's template never mentions the spec,
# but the agent carries Read/Glob/Grep/Bash, and reading the spec is the most
# natural thing an agent does when it wants to understand a task. Without this
# guard "blind" is a claim, not a property.
#
# HOW THE CALLER IS IDENTIFIED
# An agent's own frontmatter `hooks:` block does not fire (measured on CC
# 2.1.220), so the guard runs session-level from hooks/hooks.json, for every
# caller, and gates on `--agent-type` (the payload's `agent_type`: the agent's
# name inside a subagent, absent for the orchestrator). Anything that is not
# the adversarial reviewer leaves immediately — the orchestrator, the builders
# and the supervisor all need the spec.
#
# WHAT IS BLINDED
# The whole pipeline directory and the APD memory directory, as directories:
# a new state file is covered the day it is introduced. One exception:
# .reviewed-files IS the reviewer's scope.
#
# The judge is the compiled guard (apd-guard spec-blind, source in guard/ of
# the APD repository). A Read/Glob/Grep target is compared as a physical path;
# a Bash command is read by a shell parser.
#
# Interface: --agent-type <name> --file-path <path> --command <cmd> --tool <name>

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
source "$(dirname "$0")/../lib/apd-guard.sh"
[ "$APD_ACTIVE" = false ] && exit 0
[ "${APD_SKIP_SPEC_BLIND_GUARD:-}" = "1" ] && exit 0

FILE_PATH=""
COMMAND=""
AGENT_TYPE=""
TOOL=""
ARGS=("$@")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent-type) AGENT_TYPE="$2"; shift 2 ;;
    --file-path)  FILE_PATH="$2"; shift 2 ;;
    --command)    COMMAND="$2"; shift 2 ;;
    --tool)       TOOL="$2"; shift 2 ;;
    *) shift ;;
  esac
done
if [ "${APD_GUARD_ENGINE:-}" = bash ]; then
  exec bash "$0.bash" ${ARGS[@]+"${ARGS[@]}"}
fi

# Empty agent_type = the orchestrator's own call. The canonical name, and any
# renamed variant that still says what it is: a project that renames the role
# should not silently lose its blindness.
case "$AGENT_TYPE" in
  *adversarial*) : ;;
  *) exit 0 ;;
esac

_apd_guard_require guard-spec-blind
OUT=$("$APD_GUARD_BIN" spec-blind --project-dir "$PROJECT_DIR" --pipeline-dir "$PIPELINE_DIR" \
  --memory-dir "$APD_MEMORY_DIR" --agent-type "$AGENT_TYPE" --tool "$TOOL" \
  --file-path "$FILE_PATH" --command "$COMMAND" 2>&1); RC=$?
# exit 0 is an answer only together with the judge's own word
[ "$RC" -eq 0 ] && [ "$OUT" = ok ] && exit 0
[ "$RC" -eq 2 ] || _apd_guard_failed guard-spec-blind "$RC" "$OUT"

# `<audit detail><TAB><what the role may not read>`
DETAIL="${OUT%%$'\t'*}"
WHAT="${OUT#*$'\t'}"
echo "BLOCKED: adversarial-reviewer may not read $WHAT" >&2
echo "" >&2
echo "  Your review is decontextualised BY DESIGN — you judge the diff on its" >&2
echo "  own merit, without the spec, the plan or a previous pass's triage." >&2
echo "  That blindness is the whole reason this role exists; reading intent" >&2
echo "  would make your findings the same ones a contextual reviewer already" >&2
echo "  produced." >&2
echo "" >&2
echo "  Your scope is ${PIPELINE_DIR#"$PROJECT_DIR"/}/.reviewed-files — read the files it lists," >&2
echo "  in full, and nothing else. If it is empty or missing, say so and stop." >&2
log_block "spec-blind" "$DETAIL"
exit 2
