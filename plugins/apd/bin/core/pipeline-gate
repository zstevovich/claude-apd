#!/bin/bash
# APD Pipeline Gate — blocks commit if pipeline steps are not completed

source "$(dirname "$0")/../lib/resolve-project.sh"
[ "$APD_ACTIVE" = false ] && exit 0
source "$(dirname "$0")/../lib/style.sh"

mkdir -p "$PIPELINE_DIR"

MISSING=()
FORGED=()

# Resolve compiled binary for signature verification
_os_name=$(uname -s | tr '[:upper:]' '[:lower:]')
_arch_name=$(uname -m)
[ "$_arch_name" = "x86_64" ] && _arch_name="amd64"
# Linux ARM reports aarch64; the shipped binary carries Go's name for it, arm64.
# Missing validator here means signature verification is SKIPPED (`elif [ -x ]`),
# so the mismatch silently disabled the forged-.done check on that platform.
[ "$_arch_name" = "aarch64" ] && _arch_name="arm64"
APD_VALIDATOR="${APD_PLUGIN_ROOT}/bin/compiled/validate-agent-${_os_name}-${_arch_name}"

for step in spec builder reviewer verifier; do
    if [ ! -f "$PIPELINE_DIR/$step.done" ]; then
        MISSING+=("$step")
    elif [ -x "$APD_VALIDATOR" ]; then
        # Verify signature of existing .done files
        if ! "$APD_VALIDATOR" verify -step "$step" -pipeline-dir "$PIPELINE_DIR" >/dev/null 2>&1; then
            FORGED+=("$step")
        fi
    fi
done

if [ ${#MISSING[@]} -gt 0 ] || [ ${#FORGED[@]} -gt 0 ]; then
    apd_blocked "Pipeline incomplete" >&2
    echo "" >&2

    for step in spec builder reviewer verifier; do
        sc=$(_step_color "$step")
        if [ ${#FORGED[@]} -gt 0 ] && printf '%s\n' "${FORGED[@]}" | grep -qx "$step"; then
            printf "    %s□%s %s  ${RED}← forged${R}\n" "$sc" "$R" "$step" >&2
        elif [ -f "$PIPELINE_DIR/$step.done" ]; then
            printf "    %s■%s %s\n" "$sc" "$R" "$step" >&2
        else
            printf "    %s□%s %s  ${D}← missing${R}\n" "$sc" "$R" "$step" >&2
        fi
    done

    echo "" >&2
    echo "    Use: bash $APD_SHORTCUT_DISPLAY pipeline <step>" >&2
    exit 2
fi

# Stage completeness check (soft warn) — list modified files in any
# dispatched builder's scope that are not staged. Fires only when git
# repo + .agents log + at least one builder dispatched.
if command -v git >/dev/null 2>&1 && git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    AGENTS_LOG="$PIPELINE_DIR/.agents"
    if [ -f "$AGENTS_LOG" ]; then
        UNSTAGED=$(git -C "$PROJECT_DIR" diff --name-only 2>/dev/null; \
                   git -C "$PROJECT_DIR" ls-files --others --exclude-standard 2>/dev/null)
        if [ -n "$UNSTAGED" ]; then
            BUILDERS=$(awk -F'|' '$2=="start" && $3 ~ /builder/ {print $3}' "$AGENTS_LOG" | sort -u)
            DECLARED=()
            for builder in $BUILDERS; do
                AGENT_FILE=""
                for c in "$PROJECT_DIR/.apd/agents/$builder.md" "$PROJECT_DIR/.claude/agents/$builder.md"; do
                    [ -f "$c" ] && { AGENT_FILE="$c"; break; }
                done
                [ -n "$AGENT_FILE" ] || continue
                # Codex scope: YAML list
                SCOPES=$(awk '/^scope:/{flag=1; next} /^[^[:space:]-]/{flag=0} flag && /^[[:space:]]*-[[:space:]]/{sub(/^[[:space:]]*-[[:space:]]*/, ""); print}' "$AGENT_FILE")
                # CC inline: guard-scope <paths>
                if [ -z "$SCOPES" ]; then
                    SCOPES=$(grep -oE 'guard-scope[[:space:]]+[^"]+' "$AGENT_FILE" | head -1 | sed 's/guard-scope[[:space:]]*//' | tr ' ' '\n')
                fi
                while IFS= read -r scope; do
                    [ -z "$scope" ] && continue
                    scope="${scope%/}/"
                    while IFS= read -r f; do
                        [ -z "$f" ] && continue
                        case "$f/" in
                            "$scope"*) DECLARED+=("$f|$builder") ;;
                        esac
                    done <<< "$UNSTAGED"
                done <<< "$SCOPES"
            done
            if [ ${#DECLARED[@]} -gt 0 ]; then
                echo "" >&2
                warn "Modified files in builder scope but NOT staged:" >&2
                printf '%s\n' "${DECLARED[@]}" | sort -u | while IFS='|' read -r f builder; do
                    echo "    ${D}$f${R} ${D}(${builder} scope)${R}" >&2
                done
                echo "    ${D}If they belong to this commit, stage them. Otherwise stash or discard.${R}" >&2
                echo "" >&2
            fi
        fi
    fi
fi

# v7.0.5 — an unstaged file carrying a @trace for THIS spec is evidence the
# commit is about to drop.
#
# Found by the supervisor on PLAZMA (backend, 2026-07-27, SUPERVISION:6:4:2):
# builder cycle 4 added two test files, both untracked, and they were the only
# proof of the accepted finding's fix. `verify-trace` stayed GREEN because both
# R-ids are also traced by older tests — the gate asks "does R have a trace",
# never "did the trace this run produced make it into the commit". The stage
# warn above could not see them either: it filters by BUILDER scope, and the
# tests live under tests/ while the builder is scoped to src/.
#
# So this check ignores scope and ownership and asks the one question that
# matters: is there a file this commit will not carry that claims coverage for
# a criterion this spec declares? That file is the run's own evidence.
if command -v git >/dev/null 2>&1 && git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
   && [ -f "$PIPELINE_DIR/spec-card.md" ]; then
    SPEC_RIDS=$(grep -oE '^[[:space:]]*[-*][[:space:]]*(R[0-9]+)' "$PIPELINE_DIR/spec-card.md" 2>/dev/null \
                | grep -oE 'R[0-9]+' | sort -u)
    if [ -n "$SPEC_RIDS" ]; then
        ORPHAN_TRACE=""
        while IFS= read -r f; do
            [ -z "$f" ] && continue
            [ -f "$PROJECT_DIR/$f" ] || continue
            # APD's own scaffold is never a task's evidence. `rules/workflow.md`
            # SHIPS `// @trace R1` and `// @trace R2 R3` as documentation examples,
            # and it lands in every project as an untracked/unstaged file — so a
            # fresh install, or any `apd init` that refreshes it, blocked the commit
            # on APD's own instructions the moment a spec declared R1/R2/R3. Which
            # is most specs. Reported from a real project as a self-test failure;
            # the self-test was only the first place it showed.
            case "$f" in
                .claude/*|.apd/*|.codex/*|.agents/*) continue ;;
            esac
            CUR_RIDS=$(grep -oE '@trace[[:space:]]+R[0-9]+' "$PROJECT_DIR/$f" 2>/dev/null | grep -oE 'R[0-9]+' || true)
            [ -n "$CUR_RIDS" ] || continue
            # v7.0.8: an INHERITED marker is not this run's evidence. R-ids restart
            # at R1 in every spec, so a marker committed by an older cycle carries
            # today's number by coincidence — and a tracked file touched for an
            # unrelated reason would then be blocked as "tracing THIS spec", with
            # the message advising removal of a marker that is legitimate and whose
            # test really exists. Only the SURPLUS over the HEAD blob counts, the
            # same multiset rule verify-trace uses. Untracked files have no blob,
            # so they still count in full — that is the case this check was born for.
            #
            # Two limits, measured and stated rather than left to be rediscovered:
            # (1) a multiset counts HOW MANY, not WHICH — a run that removes the
            #     marker from one test and adds it to another IN THE SAME FILE keeps
            #     the count and does not block. The surviving HEAD copy keeps
            #     verify-trace green, but it may sit on the OLD test that does not
            #     exercise the change while the NEW one is left out of the commit —
            #     the same false comfort this check exists to defeat.
            # (2) a RENAMED file has no blob at its new path, so it is treated as
            #     untracked and its inherited markers block. This is NOT rare: a
            #     plain `mv`, or writing the new file and deleting the old (what an
            #     agent typically does), both reach it — only `git mv` avoids it by
            #     staging the rename. The block itself is defensible (the new path
            #     really is untracked and unstaged, and `git add` really is the fix),
            #     which is why the message speaks of markers not already in HEAD AT
            #     THIS PATH rather than claiming nothing inherited can appear.
            if git -C "$PROJECT_DIR" ls-files --error-unmatch -- ":(literal)$f" >/dev/null 2>&1; then
                HEAD_RIDS=$(git -C "$PROJECT_DIR" show "HEAD:./$f" 2>/dev/null \
                            | grep -oE '@trace[[:space:]]+R[0-9]+' | grep -oE 'R[0-9]+' || true)
                FILE_RIDS=$(printf '%s\n' "$CUR_RIDS" | sort -u | while IFS= read -r _r; do
                    [ -z "$_r" ] && continue
                    _c=$(printf '%s\n' "$CUR_RIDS" | grep -cxF "$_r" || true)
                    _h=$(printf '%s\n' "$HEAD_RIDS" | grep -cxF "$_r" || true)
                    [ "${_h:-0}" -lt "${_c:-0}" ] && printf '%s\n' "$_r"
                done)
            else
                FILE_RIDS=$(printf '%s\n' "$CUR_RIDS" | sort -u)
            fi
            [ -n "$FILE_RIDS" ] || continue
            HIT=$(printf '%s\n' $FILE_RIDS | grep -xF -f <(printf '%s\n' $SPEC_RIDS) 2>/dev/null | tr '\n' ' ')
            [ -n "$HIT" ] && ORPHAN_TRACE="${ORPHAN_TRACE}${f}|${HIT}
"
        done <<EOF
$(git -C "$PROJECT_DIR" -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null; \
  git -C "$PROJECT_DIR" -c core.quotePath=false diff --name-only 2>/dev/null)
EOF
        if [ -n "$ORPHAN_TRACE" ]; then
            echo "" >&2
            echo "BLOCKED: file(s) tracing THIS spec are not staged — the commit would ship the" >&2
            echo "         fix and drop its proof, while verify-trace stays green because the" >&2
            echo "         same R-ids are traced by older tests." >&2
            printf '%s' "$ORPHAN_TRACE" | sort -u | while IFS='|' read -r f rids; do
                [ -z "$f" ] && continue
                echo "    $f  (traces: ${rids% })" >&2
            done
            echo "" >&2
            echo "  Stage them (git add <file>). Listed markers are the ones not already" >&2
            echo "  in HEAD at that path — a marker an older cycle committed to this same" >&2
            echo "  path no longer triggers this block. A renamed or newly written file has" >&2
            echo "  no HEAD blob at its new path, so its markers count as new here even if" >&2
            echo "  the text is old; staging it is the right fix. Do NOT delete a marker to" >&2
            echo "  get past this — that trades a blocked commit for lost coverage." >&2
            log_block "untraced-evidence-unstaged" "$(printf '%s' "$ORPHAN_TRACE" | head -3 | tr '\n' ' ')"
            exit 2
        fi
    fi
fi

echo "  ${MARK_DONE} Pipeline gate: all steps complete" >&2
exit 0
