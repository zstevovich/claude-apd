#!/bin/bash
# APD Guard — records a compaction that happens while a pipeline is active
#
# PreCompact hook. Never blocks (v7.5.3). Until then it refused every
# compaction mid-pipeline, automatic ones included: Claude Code then retries
# on each turn, is refused each time, and the context grows until the session
# cannot continue — in the middle of the task the block was meant to protect.
# The task's state is on disk (spec card, plan, agent ledger, step flags), and
# the PostCompact hook (session-start) names the task, the next step and the
# commands that read the spec and the plan back.
#
# Mid-pipeline it writes one INFO line to guard-audit.log:
#   compact-during-pipeline|trigger=<manual|auto|unknown> next=<step> task=<task>

source "$(dirname "$0")/../lib/resolve-project.sh"
[ "$APD_ACTIVE" = false ] && exit 0
source "$(dirname "$0")/../lib/style.sh"

# No active pipeline — allow compaction
if [ ! -d "$PIPELINE_DIR" ] || ! ls "$PIPELINE_DIR"/*.done &>/dev/null 2>&1; then
    exit 0
fi

# Pipeline complete (all 4 steps) — allow compaction
if [ -f "$PIPELINE_DIR/spec.done" ] && [ -f "$PIPELINE_DIR/builder.done" ] && \
   [ -f "$PIPELINE_DIR/reviewer.done" ] && [ -f "$PIPELINE_DIR/verifier.done" ]; then
    exit 0
fi

# Pipeline in progress — allow, and record it
TASK="[unknown]"
NEXT_STEP=""
if [ -f "$PIPELINE_DIR/spec.done" ]; then
    TASK=$(head -1 "$PIPELINE_DIR/spec.done" | cut -d'|' -f3 2>/dev/null)
fi
for s in spec builder reviewer verifier; do
    if [ ! -f "$PIPELINE_DIR/$s.done" ]; then
        NEXT_STEP="$s"
        break
    fi
done

# The payload names who asked: "manual" (/compact) or "auto" (context full).
INPUT=""; [ -t 0 ] || INPUT=$(cat 2>/dev/null)
TRIGGER=$(printf '%s' "$INPUT" | jq -r '.trigger // empty' 2>/dev/null) || TRIGGER=""
case "$TRIGGER" in manual|auto) ;; *) TRIGGER=unknown ;; esac

if [ -d "${MEMORY_DIR:-}" ]; then
    echo "$(date +"%Y-%m-%d %H:%M:%S")|$(_audit_type INFO)|orchestrator|compact-during-pipeline|trigger=$TRIGGER next=$NEXT_STEP task=$TASK" >> "$MEMORY_DIR/guard-audit.log" 2>/dev/null
fi
exit 0
