#!/bin/bash
# APD Audit Drift — qualitative drift detection across five dimensions:
#   A. settings.json deny patterns (missing baseline entries)
#   B. .apd-config APD_VERSION (stale vs current plugin)
#   C. workflow.md content: guidance markers, then a byte comparison against
#      the shipped copy once every marker is present (v7.0.3)
#   D. feature-claim drift in workflow.md / CLAUDE.md (v6.12.3)
#   E. every other file the framework copies into a project — review agents,
#      the builder charter block, principles.md, the Codex-side copies —
#      against the framework's current text and its shipped-copy record (v7.3)
# A, C and D read CC files and are skipped on a pure-Codex project; B reads
# .apd/config there, and E covers the Codex-side copies. Marker rule: a marker must exist in the SHIPPED
# workflow.md, or it can never flag (test-codex-adapter §136 enforces this —
# `DEPRECATED` sat in this list for two releases after v7.0 deleted it).
#
# Output: severity-bucketed findings (CRITICAL / IMPORTANT / INFO / CLEAN)
# with per-item recovery action.
#
# Exit code: 0 if no drift detected, 1 if any IMPORTANT or CRITICAL drift.
# INFO-only drift returns 0 (informational, doesn't fail audit).
#
# Designed to be called from /apd-audit skill Section 8.

set -u

source "$(dirname "$0")/../lib/resolve-project.sh"
source "$(dirname "$0")/../lib/style.sh"
source "$(dirname "$0")/../lib/workflow-markers.sh"   # v7.1.6: the one marker list
source "$(dirname "$0")/../lib/shipped-sync.sh"       # v7.3: the registry of tracked copies

# Framework-self short-circuit: drift checks are irrelevant for the framework
# source repo (no project state to drift from).
if [ "${APD_FRAMEWORK_SELF:-false}" = "true" ]; then
    echo "Drift detection skipped (framework source repo)."
    exit 0
fi

# Only meaningful when APD is active in this project.
if [ "${APD_ACTIVE:-false}" != "true" ]; then
    echo "Drift detection skipped (APD inactive in this project)."
    exit 0
fi

CLAUDE_DIR="$PROJECT_DIR/.claude"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"
# v6.15 audit fix — read the activation config through the resolver (XRT-4),
# not a hardcoded legacy path: pure-Codex projects keep it at .apd/config.
APD_CONFIG="${APD_CONFIG_FILE:-$CLAUDE_DIR/.apd-config}"
APD_CONFIG_LABEL="${APD_CONFIG#"$PROJECT_DIR"/}"
WORKFLOW_FILE="$CLAUDE_DIR/rules/workflow.md"
FRAMEWORK_WORKFLOW="$APD_PLUGIN_ROOT/rules/workflow.md"
WF_RECORD="$PROJECT_DIR/.apd/.workflow.md.shipped"   # v7.1.6: the shipped copy this project took

CURRENT_PLUGIN_VERSION="${APD_VERSION:-unknown}"

CRITICAL=()
IMPORTANT=()
INFO=()

# ============================================================
# Dimension A — settings.json deny patterns drift
# ============================================================
# Baseline kept in sync with apd-init `required_deny` python list.
# When you add/remove a pattern there, update this list too.
EXPECTED_DENY=(
    "Bash(mkdir */.apd/pipeline/*)"
    "Bash(mkdir -p */.apd/pipeline/*)"
    "Bash(mkdir */.apd/pipeline)"
    "Bash(mkdir -p */.apd/pipeline)"
    "Bash(mkdir .apd/pipeline/*)"
    "Bash(mkdir -p .apd/pipeline/*)"
    "Bash(mkdir .apd/pipeline)"
    "Bash(mkdir -p .apd/pipeline)"
)

if [ -f "$SETTINGS_FILE" ] && command -v jq >/dev/null 2>&1; then
    MISSING_DENY=()
    for pattern in ${EXPECTED_DENY[@]+"${EXPECTED_DENY[@]}"}; do
        if ! jq -e --arg p "$pattern" '.permissions.deny // [] | index($p)' "$SETTINGS_FILE" >/dev/null 2>&1; then
            MISSING_DENY+=("$pattern")
        fi
    done
    if [ ${#MISSING_DENY[@]} -gt 0 ]; then
        # Bare-dir patterns (no leading slash glob) are the closing-bypass entries
        # introduced in v6.10. Slash-prefixed missing = older drift.
        IMPORTANT+=("[.claude/settings.json] ${#MISSING_DENY[@]} of ${#EXPECTED_DENY[@]} deny patterns missing")
        IMPORTANT+=("  Missing: ${MISSING_DENY[*]}")
        IMPORTANT+=("  Effect: 'mkdir .apd/pipeline' (bez prefix slash) je bypass vector — guard ne hvata")
        IMPORTANT+=("  Recovery: re-run '/apd-setup' (v6.10+ python merge fix), OR manually add missing patterns to settings.json permissions.deny array")
    fi
elif [ -f "$SETTINGS_FILE" ]; then
    INFO+=("[.claude/settings.json] jq not available — cannot parse deny patterns")
fi

# ============================================================
# Dimension B — .apd-config APD_VERSION drift
# ============================================================
if [ -f "$APD_CONFIG" ]; then
    CONFIG_VERSION=$(grep -E '^APD_VERSION=' "$APD_CONFIG" 2>/dev/null | cut -d'=' -f2 | tr -d '[:space:]"')
    if [ -z "$CONFIG_VERSION" ]; then
        IMPORTANT+=("[$APD_CONFIG_LABEL] APD_VERSION not set")
        IMPORTANT+=("  Effect: cannot detect drift, audit cannot establish baseline")
        IMPORTANT+=("  Recovery: re-run '/apd-setup' to write current APD_VERSION")
    elif [ "$CONFIG_VERSION" != "$CURRENT_PLUGIN_VERSION" ]; then
        # Parse semver minor (first two segments) for severity decision
        CONFIG_MAJOR_MINOR=$(echo "$CONFIG_VERSION" | cut -d'.' -f1-2)
        PLUGIN_MAJOR_MINOR=$(echo "$CURRENT_PLUGIN_VERSION" | cut -d'.' -f1-2)
        if [ "$CONFIG_MAJOR_MINOR" != "$PLUGIN_MAJOR_MINOR" ]; then
            IMPORTANT+=("[$APD_CONFIG_LABEL] APD_VERSION=$CONFIG_VERSION stale vs current plugin v$CURRENT_PLUGIN_VERSION")
            IMPORTANT+=("  Effect: project was configured under an older minor — workflow.md + agent templates may carry stale patterns")
            IMPORTANT+=("  Recovery: re-run '/apd-setup' to refresh templates + bump APD_VERSION in .apd-config")
        else
            INFO+=("[$APD_CONFIG_LABEL] APD_VERSION=$CONFIG_VERSION lags current plugin v$CURRENT_PLUGIN_VERSION by patch only")
            INFO+=("  Effect: minimal — patch-level changes usually do not affect project content")
            INFO+=("  Recovery: optional re-run '/apd-setup' OR ignore until next minor")
        fi
    fi
fi

# ============================================================
# Dimension D — feature claim drift (v6.12.3)
# Scans workflow.md + CLAUDE.md for orchestrator confabulation patterns
# claiming features the framework doesn't actually ship. First documented
# instance: Festico apd-setup (2026-05-28) — orchestrator wrote that
# `apd verify-contracts` auto-checks PHP DTO ↔ TS, which is false.
# Framework supports TS ↔ C# only. Pattern can repeat for any
# unsupported-language claim across verify-contracts / stack / scaffold.
# ============================================================
_check_feature_claims() {
    local file="$1"
    local file_label="$2"
    [ -f "$file" ] || return 0

    # Feature claim patterns: any line that mentions BOTH a contracts command
    # (verify-contracts / apd contracts) AND an unsupported language marker
    # (PHP/Python/Java/Go/Ruby/Kotlin/Rust). awk used because grep regex
    # can't express "both X and Y in any order on same line" cleanly.
    local found_claims=()

    for lang in PHP Python Java Go Ruby Kotlin Rust; do
        # awk: lowercase the line, check it contains both a contracts mention
        # AND the language name. Each match is a confabulation candidate.
        if awk -v lang="$(echo "$lang" | tr '[:upper:]' '[:lower:]')" '
            {
                line = tolower($0)
                has_contracts = (line ~ /verify[- ]?contracts/ || line ~ /apd[ ]+contracts/)
                has_lang = (index(line, lang) > 0)
                if (has_contracts && has_lang) { found = 1; exit }
            }
            END { exit (found ? 0 : 1) }
        ' "$file" 2>/dev/null; then
            found_claims+=("contracts command → $lang")
        fi
    done

    if [ ${#found_claims[@]} -gt 0 ]; then
        IMPORTANT+=("[$file_label] Feature claim drift — ${#found_claims[@]} unsupported language claim(s)")
        for claim in ${found_claims[@]+"${found_claims[@]}"}; do
            IMPORTANT+=("  - $claim (verify-contracts supports TypeScript ↔ C# only as of v6.12+)")
        done
        IMPORTANT+=("  Effect: orchestrator (or human reading docs) believes feature exists; relies on it; silent gap in cross-layer review coverage.")
        IMPORTANT+=("  Recovery: edit the file — replace 'apd verify-contracts ... <lang>' claims with 'cross-layer type mapping is manual — follow workflow.md section 7 (Cross-layer verification: the backend DTO is the source of truth)'. Framework reality: verify-contracts errors on unsupported langs (v6.12.2+ shows file-count + supported pairs).")
    fi
}

_check_feature_claims "$WORKFLOW_FILE" ".claude/rules/workflow.md"
_check_feature_claims "$CLAUDE_DIR/CLAUDE.md" ".claude/CLAUDE.md"
_check_feature_claims "$PROJECT_DIR/CLAUDE.md" "CLAUDE.md"

# ============================================================
# Dimension C — workflow.md content markers drift
# ============================================================
if [ -f "$WORKFLOW_FILE" ] && [ -f "$FRAMEWORK_WORKFLOW" ]; then
    # Markers track the v6.7+ guidance milestones. If framework has them
    # but project workflow does not, project is running stale guidance.
    # v7.1.6: ONE list, shared with apd-init — lib/workflow-markers.sh
    MARKERS=(${WORKFLOW_MARKERS[@]+"${WORKFLOW_MARKERS[@]}"})
    MISSING_MARKERS=()
    for marker in ${MARKERS[@]+"${MARKERS[@]}"}; do
        # grep -c returns "0" + exit 1 on no matches; ignore exit code, just
        # capture stdout. Fall back to 0 if file unreadable.
        local_count=$(grep -c "$marker" "$WORKFLOW_FILE" 2>/dev/null) || true
        framework_count=$(grep -c "$marker" "$FRAMEWORK_WORKFLOW" 2>/dev/null) || true
        local_count=${local_count:-0}
        framework_count=${framework_count:-0}
        # Framework has it but project does not → drift
        if [ "$framework_count" -gt 0 ] && [ "$local_count" -eq 0 ] 2>/dev/null; then
            MISSING_MARKERS+=("$marker")
        fi
    done
    if [ ${#MISSING_MARKERS[@]} -gt 0 ]; then
        IMPORTANT+=("[.claude/rules/workflow.md] ${#MISSING_MARKERS[@]} v6.7+ guidance markers missing")
        IMPORTANT+=("  Missing: ${MISSING_MARKERS[*]}")
        IMPORTANT+=("  Effect: orchestrator does not see plan-spec Implements format / rationale gate / v6.15 apd-pipeline-guide gate / v6.30 supervision guidance. A copy this stale still instructs --skip-brainstorm and max_defects, both removed in v7.0 — following it wastes a cycle on flags that no longer do anything")
        IMPORTANT+=("  Recovery: re-run '/apd-setup' to refresh workflow.md from current framework template")
    elif [ -d "$WF_RECORD" ]; then
        # (audit F9) a directory where the record should be: init cannot write it and says so; agree with init
        IMPORTANT+=("[.apd/.workflow.md.shipped] is a DIRECTORY, not the shipped-copy record — init cannot record or merge until it is removed")
        IMPORTANT+=("  Recovery: rmdir .apd/.workflow.md.shipped, then apd init --quick (the record is written when the copy equals the shipped file)")
    elif [ -f "$WF_RECORD" ] && [ -s "$WF_RECORD" ]; then   # (audit F12) an EMPTY record is no record — the same reading as apd-init
        # v7.1.6: the project records the shipped copy it took
        # (.apd/.workflow.md.shipped) and init MERGES framework changes into
        # its copy. So: record ≠ shipped = the framework moved and the merge
        # has not happened (or conflicted); record = shipped but copy ≠ shipped
        # = local edits or an older text — IMPORTANT in both cases.
        if ! cmp -s "$WF_RECORD" "$FRAMEWORK_WORKFLOW"; then
            WF_DELTA=$(diff "$WF_RECORD" "$FRAMEWORK_WORKFLOW" 2>/dev/null | grep -c '^[<>]') || true
            IMPORTANT+=("[.claude/rules/workflow.md] the framework's workflow.md changed since this project recorded it (${WF_DELTA:-?} changed line(s))")
            IMPORTANT+=("  Effect: the copy carries guidance from an older framework until the change is merged")
            IMPORTANT+=("  Recovery: init merges it on the next session start (or now: apd init --quick), keeping local edits; if init reported a CONFLICT, resolve it via /apd-setup step 5c")
        elif ! cmp -s "$WORKFLOW_FILE" "$FRAMEWORK_WORKFLOW"; then
            # (audit F2) record = shipped does NOT prove the difference is a local
            # edit: an older framework text put back (a git checkout with .apd/
            # unversioned, a restored backup) looks the same. v7.0.3's contract
            # stands — this file is a plain copy, byte-equality is the contract —
            # so it is IMPORTANT either way; init keeps local edits through its
            # merge, it does not sanction them.
            WF_DELTA=$(diff "$FRAMEWORK_WORKFLOW" "$WORKFLOW_FILE" 2>/dev/null | grep -c '^[<>]') || true
            IMPORTANT+=("[.claude/rules/workflow.md] differs from the shipped file (${WF_DELTA:-?} changed line(s)) — local edits, or an older text put back; the shipped-copy record cannot tell them apart")
            IMPORTANT+=("  Effect: the project may be running RETRACTED guidance; project-specific rules belong in CLAUDE.md, this file is a plain copy of the framework's")
            IMPORTANT+=("  Recovery: take the shipped file — cp $FRAMEWORK_WORKFLOW .claude/rules/workflow.md (back it up first). Init keeps local edits through its merge, so this stays reported until the copy equals the shipped file")
        fi
    elif ! cmp -s "$WORKFLOW_FILE" "$FRAMEWORK_WORKFLOW"; then
        # v7.0.3: the marker sweep above is ONE-WAY — it asks "framework has it,
        # project doesn't". It is structurally blind to a project still carrying
        # a section the framework DELETED, which is the more dangerous half: the
        # orchestrator reads instructions the framework has retracted.
        # Measured on Bambi 2026-07-26: 103 lines behind, still carrying the v6
        # "Raising maxTurns makes pipelines faster" section that v6.31 removed
        # (maxTurns was proven a no-op on 2026-07-09), every marker present —
        # and this dimension reported CLEAN. workflow.md is a plain `cp` with no
        # placeholders, so byte-equality is the entire contract.
        # v7.1.6: this branch is the NO-RECORD case (set up before v7.1.6).
        WF_DELTA=$(diff "$FRAMEWORK_WORKFLOW" "$WORKFLOW_FILE" 2>/dev/null | grep -c '^[<>]') || true
        IMPORTANT+=("[.claude/rules/workflow.md] differs from the shipped file (${WF_DELTA:-?} changed line(s)) — every guidance marker is present, so the marker sweep passes it")
        IMPORTANT+=("  Effect: the project may be running RETRACTED guidance. A marker check cannot see instructions the framework has since deleted — it only sees ones it has added")
        IMPORTANT+=("  Recovery: re-run '/apd-setup' to refresh workflow.md (init keeps the current copy as workflow.md.bak.preaudit). If the difference is deliberate, that file is a plain copy of the framework's — put project-specific rules in CLAUDE.md instead")
        IMPORTANT+=("  No shipped-copy record (.apd/.workflow.md.shipped): the project was set up before v7.1.6 — step 5c creates it, and from then on init merges framework changes into the copy on its own")
    fi
fi

# ============================================================
# Dimension E — the framework's other copies (v7.3)
# ============================================================
# Until v7.3 nothing compared these with the framework's text: dimension B asks
# whether APD_VERSION equals the plugin's, and init raises APD_VERSION on every
# run whatever the agents carry. Measured on PLAZMA 2026-10-03: three review
# agents one release behind, APD_VERSION current, this script CLEAN.
#
# Same registry and the same renders as init (lib/shipped-sync.sh), so a state
# init would act on is a state this reports:
#   record ≠ the framework's text      → IMPORTANT (the merge has not happened)
#   no record, an OLDER shipped text   → IMPORTANT (init refreshes it)
#   no record, an earlier text + edits → IMPORTANT (init merges from the nearest earlier text)
#   no record, no stored text to merge → IMPORTANT (edited, and cut off from updates)
#   local edits on the current text    → INFO      (init merges framework changes around them)
#   nothing like any shipped text      → INFO      (the project's own file, not tracked)
E_TMP=$(mktemp -d -t apd-driftE.XXXXXX 2>/dev/null || echo "")
if [ -n "$E_TMP" ] && [ -d "$E_TMP" ]; then
    _e_judge() {   # <label> <copy> <shipped render> <record> <history key> <canon name> <kind>
        local label="$1" copy="$2" shipped="$3" record="$4" hkey="$5" cname="$6" kind="$7" base rs delta arc
        rs=$(_ss_record_state "$record")
        if [ "$rs" = dir ]; then
            IMPORTANT+=("[$label] its shipped-copy record ${record#"$PROJECT_DIR"/} is a DIRECTORY — init cannot record or merge until it is removed")
            IMPORTANT+=("  Recovery: rmdir ${record#"$PROJECT_DIR"/}, then apd init --quick")
        elif [ "$rs" = ok ]; then
            base="$record"
            if [ -n "$E_PINS" ]; then cp "$record" "$E_TMP/base" 2>/dev/null && { _ss_carry_pins "$E_TMP/base" "$E_PINS"; _ss_like "$E_TMP/base" "$E_PINS"; base="$E_TMP/base"; }; fi
            if ! cmp -s "$base" "$shipped"; then
                delta=$(diff "$base" "$shipped" 2>/dev/null | grep -c '^[<>]') || true
                IMPORTANT+=("[$label] the framework's text changed since this project recorded it (${delta:-?} changed line(s))")
                IMPORTANT+=("  Effect: the copy carries an older framework text until the change is merged")
                IMPORTANT+=("  Recovery: init merges it on the next session start (or now: apd init --quick), keeping local edits; a CONFLICT is reported by init with the by-hand recipe")
            elif ! cmp -s "$copy" "$shipped"; then
                delta=$(diff "$shipped" "$copy" 2>/dev/null | grep -c '^[<>]') || true
                INFO+=("[$label] carries local edits (${delta:-?} line(s) differ from the framework's text)")
                INFO+=("  Effect: none — init merges framework changes around them")
            fi
        elif cmp -s "$copy" "$shipped"; then
            :   # current; init starts the record on its next run
        elif _ss_history_has "$hkey" "$copy" "$cname" "$kind"; then
            IMPORTANT+=("[$label] carries a text the framework shipped in an EARLIER version (no local edits, no record)")
            IMPORTANT+=("  Effect: the role runs on instructions the framework has since changed")
            IMPORTANT+=("  Recovery: apd init --quick refreshes it (backup kept) and starts the record")
        else
            arc=1
            _ss_ancestor "$hkey" "$kind" "$copy" "$E_TMP/anc" "$shipped"; arc=$?
            if [ "$arc" -eq 0 ]; then
                # no record, local edits on an earlier (or the current) shipped text
                if cmp -s "$E_TMP/anc" "$shipped"; then
                    delta=$(diff "$shipped" "$copy" 2>/dev/null | grep -c '^[<>]') || true
                    INFO+=("[$label] carries local edits (${delta:-?} line(s) differ from the framework's text); no record yet")
                    INFO+=("  Effect: none — init starts the record on its next run and merges framework changes around the edits")
                else
                    delta=$(diff "$E_TMP/anc" "$shipped" 2>/dev/null | grep -c '^[<>]') || true
                    IMPORTANT+=("[$label] was made from an EARLIER shipped text and edited locally; the framework changed ${delta:-?} line(s) since (no record)")
                    IMPORTANT+=("  Effect: the role runs on instructions the framework has since changed")
                    IMPORTANT+=("  Recovery: apd init --quick merges the framework's changes around the local edits (backup kept), or reports a CONFLICT with the by-hand recipe")
                fi
            elif [ "$arc" -eq 2 ]; then
                INFO+=("[$label] is the project's own text — not derived from any text the framework shipped")
                INFO+=("  Effect: it is not tracked: framework changes to this file's template do not reach it, by the project's choice")
            else
                delta=$(diff "$shipped" "$copy" 2>/dev/null | grep -c '^[<>]') || true
                IMPORTANT+=("[$label] differs from the framework's text (${delta:-?} line(s)) and has no shipped-copy record")
                IMPORTANT+=("  Effect: edited locally and cut off from framework changes — init cannot merge without a record and will not overwrite an edit")
                IMPORTANT+=("  Recovery: see the init message for this file (it names the record to create, or how to take the framework's text)")
            fi
        fi
    }
    while IFS='|' read -r e_key e_kind e_tmpl e_rel; do
        [ -n "$e_key" ] || continue
        SS_PIN_DEFAULTS="$APD_PLUGIN_ROOT/$e_tmpl"
        _ss_render "$e_kind" "$APD_PLUGIN_ROOT/$e_tmpl" "$PROJECT_DIR/$e_rel" "$E_TMP/shipped" || continue
        E_PINS=""; [ "$e_kind" = agent ] && E_PINS="$PROJECT_DIR/$e_rel"
        _e_judge "$e_rel" "$PROJECT_DIR/$e_rel" "$E_TMP/shipped" "$(_ss_record_path "$e_key")" "$e_key" "$(_ss_project_name "$e_kind")" "$e_kind"
    done < <(_ss_registry)
    if _ss_charter_shipped "$E_TMP/charter.shipped" && [ -d "$CLAUDE_DIR/agents" ]; then
        for e_ag in "$CLAUDE_DIR"/agents/*.md; do
            [ -f "$e_ag" ] || continue
            case "$(basename "$e_ag")" in apd-verify-*) continue ;; esac
            e_n=$(basename "$e_ag" .md)
            _ss_charter_extract "$e_ag" "$E_TMP/charter.copy" || continue
            E_PINS=""; SS_PIN_DEFAULTS=""
            _e_judge "builder charter in .claude/agents/$e_n.md" "$E_TMP/charter.copy" "$E_TMP/charter.shipped" "$(_ss_record_path "charter-$e_n")" "charter" "" plain
        done
    fi
    rm -rf "$E_TMP"
fi

# ============================================================
# Render output
# ============================================================
TOTAL=$((${#CRITICAL[@]} + ${#IMPORTANT[@]} + ${#INFO[@]}))

echo ""
echo "${B}APD Drift Detection${R} (v6.10+)"
echo ""

if [ ${#CRITICAL[@]} -gt 0 ]; then
    echo "${R}${B}CRITICAL:${R}"
    n=0
    for line in ${CRITICAL[@]+"${CRITICAL[@]}"}; do
        if [[ "$line" =~ ^\[ ]]; then
            n=$((n + 1))
            echo "  $n. $line"
        else
            echo "  $line"
        fi
    done
    echo ""
fi

if [ ${#IMPORTANT[@]} -gt 0 ]; then
    echo "${Y}${B}IMPORTANT:${R}"
    n=0
    for line in ${IMPORTANT[@]+"${IMPORTANT[@]}"}; do
        if [[ "$line" =~ ^\[ ]]; then
            n=$((n + 1))
            echo "  $n. $line"
        else
            echo "  $line"
        fi
    done
    echo ""
fi

if [ ${#INFO[@]} -gt 0 ]; then
    echo "${D}INFO:${R}"
    n=0
    for line in ${INFO[@]+"${INFO[@]}"}; do
        if [[ "$line" =~ ^\[ ]]; then
            n=$((n + 1))
            echo "  $n. $line"
        else
            echo "  $line"
        fi
    done
    echo ""
fi

if [ $TOTAL -eq 0 ]; then
    echo "${G}CLEAN:${R} no drift detected — project tracks current framework baseline"
    echo ""
fi

# Exit 1 if any CRITICAL or IMPORTANT drift (INFO-only = exit 0)
if [ ${#CRITICAL[@]} -gt 0 ] || [ ${#IMPORTANT[@]} -gt 0 ]; then
    exit 1
fi
exit 0
