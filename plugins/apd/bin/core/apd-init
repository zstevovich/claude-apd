#!/bin/bash
# APD Init — initializes or updates APD environment in a project
#
# Two modes:
#   NEW PROJECT:      No .apd-config → creates everything from scratch
#   EXISTING PROJECT: .apd-config exists → gap analysis, fixes what's missing
#
# Uses userConfig env vars when available:
#   CLAUDE_PLUGIN_OPTION_PROJECT_NAME, CLAUDE_PLUGIN_OPTION_STACK, CLAUDE_PLUGIN_OPTION_AUTHOR_NAME

source "$(dirname "$0")/../lib/resolve-project.sh"

# APD version comes from the runtime-neutral VERSION file (resolve-project.sh)
APD_VER="${APD_VERSION:-0.0.0}"

# --version flag: show APD version and exit
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    echo "APD v${APD_VER} (plugin: $APD_PLUGIN_ROOT)"
    exit 0
fi

# v6.5 framework-self protection: when the plugin is loaded against its own
# source repo, refuse to scaffold/init. The user gets slash skills and MCP
# tools without auto-scaffolding turning the framework source into a managed
# consumer project. Power users opt in via APD_FRAMEWORK_DEV_MODE=force-enable.
if [ "$APD_FRAMEWORK_SELF" = "true" ] && [ "${APD_FRAMEWORK_DEV_MODE:-}" != "force-enable" ]; then
    if [ "${1:-}" != "--quick" ]; then
        echo "APD framework self-detected at $PROJECT_DIR — init skipped (framework dev mode)." >&2
        echo "Skills + MCP tools remain available; pipeline enforcement is off." >&2
        echo "Set APD_FRAMEWORK_DEV_MODE=force-enable to override (dogfood the framework on itself)." >&2
    fi
    exit 0
fi

# --quick flag: skip verification (used by session-start)
QUICK=false
[ "${1:-}" = "--quick" ] && QUICK=true

# --- Eager version sync ---
# Plugin upgrade leaves $CLAUDE_DIR/.apd-version stale until the per-MODE path
# rewrites it. session-start reads it for the banner, and the per-MODE write
# (MODE=update §593) runs late — anything that exits early (errors, --version)
# would skip it. Sync up front so the banner is always correct.
if [ -d "$CLAUDE_DIR" ] && [ -n "$APD_VER" ] && [ "$APD_VER" != "0.0.0" ]; then
    PROJ_V=$(cat "$CLAUDE_DIR/.apd-version" 2>/dev/null | tr -d '[:space:]')
    # Sync when content differs from the live plugin version. Includes the empty
    # case (no .apd-version yet) so an early-exit code path (e.g. --version) still
    # leaves the project with a correct .apd-version for the next session-start
    # banner. v6.3 audit fix: was previously gated on `[ -n "$PROJ_V" ]` which
    # skipped first-write entirely.
    if [ "$PROJ_V" != "$APD_VER" ]; then
        echo "$APD_VER" > "$CLAUDE_DIR/.apd-version"
    fi
fi

# --- Visual helpers ---
source "$(dirname "$0")/../lib/style.sh"
source "$(dirname "$0")/../lib/workflow-markers.sh"
source "$(dirname "$0")/../lib/shipped-sync.sh"   # v7.3: one sync for every copied file

FIXES=0
SKIPS=0

# v7.3: every agent init writes from a template goes through the SAME render the
# shipped-copy sync compares against (lib/shipped-sync.sh). The old
# `sed "s/{{PROJECT_NAME}}/$PROJECT_NAME/g"` read `&`, `/` and `\` in a project's
# name as sed syntax — "Plaz&ma" came out as "Plaz{{PROJECT_NAME}}ma".
# _init_backup <file> <slot> → 0 when a backup HOLDING the file's current content
# exists; INIT_BAK names it. The slot is first-wins only for the same content: a
# slot that already holds another text gets a numbered sibling, so the copy
# replaced now is never in no file at all (audit-730 pass 3).
_init_backup() {
    INIT_BAK="$2"
    if [ -f "$INIT_BAK" ]; then
        cmp -s "$INIT_BAK" "$1" && return 0
        INIT_BAK="$2.$(date +%s).$$"
    fi
    cp -p "$1" "$INIT_BAK" 2>/dev/null
}

_init_render_agent() {   # <template> <destination> → 0 when the agent was written
    # `agentraw`: the TEMPLATE's model:/effort: — a creation or a marker refresh
    # writes the template as it is, and the pin logic around the call decides
    # what the profile owns (audit-730 F1: carrying the project's pins here kept
    # a stale `effort: low` through a refresh that used to reset it).
    # Written THROUGH the destination (`cat >`), so a symlinked agent stays a
    # symlink (F6), and a destination that cannot be written says so.
    local _t
    _t=$(mktemp -t apd-agent.XXXXXX 2>/dev/null) || { warn "$(basename "$2"): no temp file (TMPDIR?) — not written"; return 1; }
    if _ss_render agentraw "$1" "$2" "$_t" && { cat "$_t" > "$2"; } 2>/dev/null; then rm -f "$_t"; return 0; fi
    rm -f "$_t"
    warn "$(basename "$2"): could not write $2 — left as it was (check permissions)"
    return 1
}

apd_logo
apd_header "Init"
echo ""

# ===========================================================
# DETECT MODE
# ===========================================================
if [ -n "$APD_CONFIG_FILE" ] && [ -f "$APD_CONFIG_FILE" ]; then
    MODE="update"
    echo "  Mode: ${B}Update${R} (existing APD project at $APD_CONFIG_FILE)"
    PROJECT_NAME=$(grep '^PROJECT_NAME=' "$APD_CONFIG_FILE" 2>/dev/null | cut -d= -f2-)
    STACK=$(grep '^STACK=' "$APD_CONFIG_FILE" 2>/dev/null | cut -d= -f2-)
else
    MODE="new"
    echo "  Mode: ${B}New project${R}"
    # Read from userConfig or fallback
    PROJECT_NAME="${CLAUDE_PLUGIN_OPTION_PROJECT_NAME:-}"
    STACK="${CLAUDE_PLUGIN_OPTION_STACK:-}"
    AUTHOR="${CLAUDE_PLUGIN_OPTION_AUTHOR_NAME:-}"
fi
echo ""

# ===========================================================
# NEW PROJECT — create everything from scratch
# ===========================================================
if [ "$MODE" = "new" ]; then
    if [ -z "$PROJECT_NAME" ]; then
        err "PROJECT_NAME not set. Configure userConfig in plugin settings or set CLAUDE_PLUGIN_OPTION_PROJECT_NAME."
        exit 1
    fi
    if [ -z "$STACK" ]; then
        err "STACK not set. Configure userConfig in plugin settings or set CLAUDE_PLUGIN_OPTION_STACK."
        exit 1
    fi

    echo "  Project: $PROJECT_NAME"
    echo "  Stack:   $STACK"
    echo "  Author:  ${AUTHOR:-$(git config user.name 2>/dev/null || echo 'unknown')}"
    echo ""

    AUTHOR="${AUTHOR:-$(git config user.name 2>/dev/null || echo 'Developer')}"

    # Create directories
    mkdir -p "$CLAUDE_DIR/agents" "$CLAUDE_DIR/rules" "$CLAUDE_DIR/scripts" "$CLAUDE_DIR/bin" "$CLAUDE_DIR/memory" "$PROJECT_DIR/.apd/pipeline"

    # .apd-config
    cat > "$CLAUDE_DIR/.apd-config" << EOF
PROJECT_NAME=$PROJECT_NAME
APD_VERSION=$APD_VER
STACK=$STACK
EOF
    fix "Created .apd-config"

    # .apd-version
    echo "$APD_VER" > "$CLAUDE_DIR/.apd-version"
    fix "Created .apd-version"

    # Copy workflow.md — and record the shipped copy it came from (v7.1.6 merge base; audit F5: NEW mode skipped it)
    if [ -f "$APD_PLUGIN_ROOT/rules/workflow.md" ]; then
        cp "$APD_PLUGIN_ROOT/rules/workflow.md" "$CLAUDE_DIR/rules/workflow.md"
        mkdir -p "$PROJECT_DIR/.apd" 2>/dev/null && cp "$APD_PLUGIN_ROOT/rules/workflow.md" "$PROJECT_DIR/.apd/.workflow.md.shipped" 2>/dev/null || true
        fix "Copied workflow.md"
    fi

    # Generate principles.md
    if [ -f "$APD_PLUGIN_ROOT/templates/principles/en.md" ]; then
        cp "$APD_PLUGIN_ROOT/templates/principles/en.md" "$CLAUDE_DIR/rules/principles.md"
        fix "Created principles.md"
    fi

    # Generate verify-all.sh from stack template
    VERIFY_TEMPLATE="$APD_PLUGIN_ROOT/templates/verify-all/${STACK}.sh"
    if [ -f "$VERIFY_TEMPLATE" ]; then
        cat > "$CLAUDE_DIR/scripts/verify-all.sh" << 'HEADER'
#!/bin/bash
# APD Verify All — runs verification for all changed components
# This script lives IN THE PROJECT (.claude/scripts/verify-all.sh), not in the plugin.

PROJECT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$PROJECT_DIR" || exit 0

# Scope — "full" (default) or "fast" (build + touched tests only).
# Set by apd_verify_step(scope="fast") via APD_VERIFY_SCOPE env var.
# pipeline-advance verifier always runs with the default (unset → full).
export APD_VERIFY_SCOPE="${APD_VERIFY_SCOPE:-full}"

# Cache — skip if Verifier step already passed recently
VERIFIED_TS_FILE="$PROJECT_DIR/.apd/pipeline/verified.timestamp"
if [ -f "$VERIFIED_TS_FILE" ]; then
    VERIFIED_AT=$(cat "$VERIFIED_TS_FILE" 2>/dev/null | tr -d '[:space:]')
    NOW=$(date +%s)
    if [ -n "$VERIFIED_AT" ] && [ "$VERIFIED_AT" -gt 0 ] 2>/dev/null; then
        AGE=$((NOW - VERIFIED_AT))
        if [ "$AGE" -lt 120 ]; then
            echo "Verification skipped — Verifier passed ${AGE}s ago (cache <120s)" >&2
            exit 0
        fi
    fi
fi

ERRORS=()
CHANGED_FILES=$(git diff --cached --name-only 2>/dev/null)
[ -z "$CHANGED_FILES" ] && CHANGED_FILES=$(git diff --name-only HEAD 2>/dev/null)

HEADER
        cat "$VERIFY_TEMPLATE" >> "$CLAUDE_DIR/scripts/verify-all.sh"
        cat >> "$CLAUDE_DIR/scripts/verify-all.sh" << 'FOOTER'

# Result
if [ ${#ERRORS[@]} -gt 0 ]; then
    echo "VERIFICATION FAILED:"
    for e in "${ERRORS[@]}"; do echo "  - $e"; done
    exit 1
fi
echo "Verification passed"
exit 0
FOOTER
        chmod +x "$CLAUDE_DIR/scripts/verify-all.sh"
        fix "Created verify-all.sh ($STACK)"
    else
        err "No verify-all template for stack: $STACK"
    fi

    # Memory files
    for file in MEMORY.md status.md session-log.md; do
        if [ ! -f "$CLAUDE_DIR/memory/$file" ]; then
            if [ -f "$APD_PLUGIN_ROOT/templates/memory/$file" ]; then
                cp "$APD_PLUGIN_ROOT/templates/memory/$file" "$CLAUDE_DIR/memory/$file"
            else
                touch "$CLAUDE_DIR/memory/$file"
            fi
            fix "Created memory/$file"
        fi
    done

    # Settings.json
    cat > "$CLAUDE_DIR/settings.json" << EOF
{
  "env": {
    "APD_PROJECT_NAME": "$PROJECT_NAME"
  },
  "permissions": {
    "allow": [
      "Edit(.claude/memory/**)",
      "Edit(**/.claude/memory/**)",
      "Edit(.apd/pipeline/spec-card.md)",
      "Edit(.apd/pipeline/implementation-plan.md)",
      "Edit(.apd/pipeline/.adversarial-summary)",
      "Edit(.apd/pipeline/.adversarial-rationale.md)",
      "Edit(.apd/pipeline/.supervision-summary)",
      "Edit(.apd/pipeline/.supervision-rationale.md)",
      "Edit(.apd/pipeline/.guide-marker)",
      "Edit(**/.apd/pipeline/spec-card.md)",
      "Edit(**/.apd/pipeline/implementation-plan.md)",
      "Edit(**/.apd/pipeline/.adversarial-summary)",
      "Edit(**/.apd/pipeline/.adversarial-rationale.md)",
      "Edit(**/.apd/pipeline/.supervision-summary)",
      "Edit(**/.apd/pipeline/.supervision-rationale.md)",
      "Edit(**/.apd/pipeline/.guide-marker)",
      "Bash(bash .claude/bin/apd *)",
      "Bash(bash .claude/bin/apd pipeline *)"
    ],
    "deny": [
      "Bash(mkdir */.apd/pipeline/*)",
      "Bash(mkdir -p */.apd/pipeline/*)",
      "Bash(mkdir */.apd/pipeline)",
      "Bash(mkdir -p */.apd/pipeline)",
      "Bash(mkdir .apd/pipeline/*)",
      "Bash(mkdir -p .apd/pipeline/*)",
      "Bash(mkdir .apd/pipeline)",
      "Bash(mkdir -p .apd/pipeline)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[$PROJECT_NAME] Claude needs attention'"
          }
        ]
      }
    ]
  }
}
EOF
    fix "Created settings.json (superpowers disabled, attribution empty)"

    # Gitignore entries
    if [ -f "$APD_PLUGIN_ROOT/templates/gitignore-entries.txt" ]; then
        if [ ! -f "$PROJECT_DIR/.gitignore" ]; then
            cat "$APD_PLUGIN_ROOT/templates/gitignore-entries.txt" > "$PROJECT_DIR/.gitignore"
            fix "Created .gitignore"
        else
            while IFS= read -r entry; do
                [ -z "$entry" ] && continue
                [[ "$entry" == \#* ]] && continue
                if ! grep -qF "$entry" "$PROJECT_DIR/.gitignore" 2>/dev/null; then
                    echo "$entry" >> "$PROJECT_DIR/.gitignore"
                fi
            done < "$APD_PLUGIN_ROOT/templates/gitignore-entries.txt"
            fix "Updated .gitignore"
        fi
    fi

    # Git init if needed
    if ! git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree &>/dev/null; then
        git -C "$PROJECT_DIR" init -q
        fix "Initialized git repo"
    fi

    echo ""
    echo "  ${B}NOTE:${R} CLAUDE.md and agents must be generated by the orchestrator"
    echo "  using the /apd-setup skill — they require project analysis."
    echo ""

    FIXES=$((FIXES + 1))
fi

# ===========================================================
# UPDATE MODE — gap analysis, fix what's missing
# ===========================================================
if [ "$MODE" = "update" ]; then
    echo "  Project: $PROJECT_NAME"
    echo "  Stack:   $STACK"
    echo ""

    # --- .apd-config APD_VERSION sync (v6.16.1) ---
    # The repair path historically wrote APD_VERSION only at scaffold time, so
    # upgraded projects carried stale versions forever and audit-drift dimension
    # B pointed at a recovery (re-run init/setup) that did not actually fix it.
    CFG_VER=$(grep '^APD_VERSION=' "$APD_CONFIG_FILE" 2>/dev/null | cut -d= -f2-)
    if [ -n "$APD_VER" ] && [ "$APD_VER" != "0.0.0" ] && [ "$CFG_VER" != "$APD_VER" ]; then
        if grep -q '^APD_VERSION=' "$APD_CONFIG_FILE" 2>/dev/null; then
            awk -v v="$APD_VER" '/^APD_VERSION=/ { print "APD_VERSION=" v; next } { print }' \
                "$APD_CONFIG_FILE" > "$APD_CONFIG_FILE.apdtmp" && mv "$APD_CONFIG_FILE.apdtmp" "$APD_CONFIG_FILE"
        else
            echo "APD_VERSION=$APD_VER" >> "$APD_CONFIG_FILE"
        fi
        fix ".apd-config: APD_VERSION ${CFG_VER:-none} → $APD_VER"
        FIXES=$((FIXES + 1))
    fi

    # Model profile (v6.16) owns agent model/effort when declared — the
    # hardcoded model repairs below must not fight `apd profile` (session-start
    # runs this script every session and would silently revert burn/eco).
    DECLARED_PROFILE=$(grep '^MODEL_PROFILE=' "$APD_CONFIG_FILE" 2>/dev/null | head -1 | cut -d= -f2-)

    # v7.0 — a declared profile only OWNS the role classes it actually names.
    # Since no named role falls back to `default` any more, a conf without a
    # `reviewer` row leaves `code-reviewer` on its template pin — `apd profile`
    # deliberately does not touch it. Skipping the repair on the mere PRESENCE of
    # a profile therefore left that role owned by NOBODY: init deferred to the
    # profile, the profile ignored it, and a hand-edited model would stand
    # forever. Ask the conf, not the config flag.
    _profile_owns() {   # $1 = role class as it appears in model-profiles.conf
        [ -n "$DECLARED_PROFILE" ] || return 1
        local _conf="$PROJECT_DIR/.apd/model-profiles.conf"
        [ -f "$_conf" ] || _conf="$APD_PLUGIN_ROOT/templates/model-profiles.conf"
        [ -f "$_conf" ] || return 1
        grep -qE "^${DECLARED_PROFILE}\|$1\|" "$_conf" 2>/dev/null
    }

    # The repair pins come from the TEMPLATES (v7.1.9) — the one authority for
    # what a role runs on when no profile owns it. Init used to carry its own
    # copy of the reviewer/adversarial ids, so every generation change had to
    # be made twice, and a file that matched init's copy read "ok" even when
    # the template had moved on. An unreadable template = no pin = no repair.
    REVIEWER_PIN=$(awk '/^model:/ {print $2; exit}' "$APD_PLUGIN_ROOT/templates/reviewer-template.md" 2>/dev/null)
    ADVERSARIAL_PIN=$(awk '/^model:/ {print $2; exit}' "$APD_PLUGIN_ROOT/templates/adversarial-reviewer-template.md" 2>/dev/null)

    # v7.3: a PURE-CODEX project (config in .apd/, no .claude/ directory) gets no
    # CC-native step. Until now this whole section ran for it: every session start
    # (the Codex session-start hook calls init) created .claude/rules/workflow.md,
    # .claude/memory/* and .claude/.apd-version and tried to write CC review
    # agents — the Codex runtime imposing .claude/ on a project that never asked
    # for it, after which the installer and the resolver treated the project as a
    # hybrid and read the CC copy of the rules. Measured 2026-10-03 on a fixture.
    CC_SIDE=true
    case "${APD_CONFIG_FILE:-}" in
        "$PROJECT_DIR"/.apd/*) [ -d "$CLAUDE_DIR" ] || CC_SIDE=false ;;
    esac
    if [ "$CC_SIDE" = false ]; then
        ok "pure-Codex project — CC-native steps skipped (.claude/ is not created)"
    elif [ ! -f "$CLAUDE_DIR/.apd-config" ] && [ ! -d "$CLAUDE_DIR/agents" ] && [ -f "$PROJECT_DIR/.apd/config" ] && [ -d "$PROJECT_DIR/.codex" ]; then
        warn ".claude/ holds no APD config and no agents while the project is configured in .apd/config — it was most likely created by an APD init before v7.3 on a pure-Codex project. It makes APD read .claude/rules/workflow.md instead of .apd/rules/workflow.md; if Claude Code is not used here, remove .claude/ by hand"
    fi
    if [ "$CC_SIDE" = true ]; then
    # --- code-reviewer agent ---
    if [ -f "$CLAUDE_DIR/agents/code-reviewer.md" ]; then
        # Check model. Three-way since v7.0, because "a profile is declared" and
        # "the profile owns this role" stopped being the same thing.
        if _profile_owns reviewer; then
            ok "code-reviewer (model managed by profile '$DECLARED_PROFILE')"
        elif [ -z "$REVIEWER_PIN" ]; then
            warn "code-reviewer: reviewer-template.md unreadable — model pin not checked"
        elif [ -n "$DECLARED_PROFILE" ]; then
            # Declared but UNOWNED: no `reviewer` row, so `apd profile` leaves this
            # agent alone. Init deliberately leaves it alone too — rewriting a
            # hand-picked model on every session-start is precisely the footgun
            # v6.16.1 removed. But say so, because the previous wording claimed the
            # profile was managing a role nothing was managing.
            if grep -qE "^model: ${REVIEWER_PIN}[[:space:]]*$" "$CLAUDE_DIR/agents/code-reviewer.md" 2>/dev/null; then
                ok "code-reviewer (template pin; profile '$DECLARED_PROFILE' has no reviewer row)"
            else
                warn "code-reviewer: $(grep -m1 '^model:' "$CLAUDE_DIR/agents/code-reviewer.md" 2>/dev/null) — profile '$DECLARED_PROFILE' carries no reviewer row, so NOTHING manages this model (template pin is $REVIEWER_PIN). Left as-is; change it deliberately or add a reviewer row."
            fi
        elif grep -qE "^model: ${REVIEWER_PIN}[[:space:]]*$" "$CLAUDE_DIR/agents/code-reviewer.md" 2>/dev/null; then
            ok "code-reviewer ($REVIEWER_PIN/max)"
        else
            sed -i.bak "s/^model:.*/model: $REVIEWER_PIN/" "$CLAUDE_DIR/agents/code-reviewer.md" 2>/dev/null && rm -f "$CLAUDE_DIR/agents/code-reviewer.md.bak"
            fix "code-reviewer: fixed model to $REVIEWER_PIN"
            FIXES=$((FIXES + 1))
        fi
        # Check scope directive (v4.7.10+) — regenerate if missing
        if ! grep -q 'reviewed-files' "$CLAUDE_DIR/agents/code-reviewer.md" 2>/dev/null; then
            if [ -f "$APD_PLUGIN_ROOT/templates/reviewer-template.md" ]; then
                # (audit-730, pre-existing) this refresh replaced the whole file with no
                # backup — every local line of an old customised reviewer was lost
                if ! _init_backup "$CLAUDE_DIR/agents/code-reviewer.md" "$CLAUDE_DIR/agents/code-reviewer.md.bak.pre-v$APD_VER"; then
                    warn "code-reviewer: no .reviewed-files directive, but the backup could not be written — NOT refreshed (never without a backup)"
                elif _init_render_agent "$APD_PLUGIN_ROOT/templates/reviewer-template.md" "$CLAUDE_DIR/agents/code-reviewer.md"; then
                    fix "code-reviewer: refreshed from template (added .reviewed-files scope directive; previous copy kept as $(basename "$INIT_BAK"))"
                    FIXES=$((FIXES + 1))
                fi
            fi
        fi
    else
        if [ -f "$APD_PLUGIN_ROOT/templates/reviewer-template.md" ]; then
            if _init_render_agent "$APD_PLUGIN_ROOT/templates/reviewer-template.md" "$CLAUDE_DIR/agents/code-reviewer.md"; then
                fix "Created code-reviewer.md (${REVIEWER_PIN:-template pin}/max, read-only)"
                FIXES=$((FIXES + 1))
            fi
        fi
    fi

    # --- adversarial-reviewer agent (optional but recommended) ---
    if [ -f "$CLAUDE_DIR/agents/adversarial-reviewer.md" ]; then
        if _profile_owns adversarial; then
            # Profile owns the model; still surface a missing memory:none (positional
            # independence contract) without touching the model line.
            if grep -q 'memory: none' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null; then
                ok "adversarial-reviewer (model managed by profile '$DECLARED_PROFILE', memory: none)"
            else
                warn "adversarial-reviewer: missing 'memory: none' (decontextualization contract)"
            fi
        elif [ -z "$ADVERSARIAL_PIN" ]; then
            warn "adversarial-reviewer: adversarial-reviewer-template.md unreadable — model pin not checked"
        elif grep -qE "^model: ${ADVERSARIAL_PIN}[[:space:]]*$" "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null && grep -q 'memory: none' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null; then
            ok "adversarial-reviewer ($ADVERSARIAL_PIN/max, memory: none)"
        else
            sed -i.bak "s/^model:.*/model: $ADVERSARIAL_PIN/" "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null && rm -f "$CLAUDE_DIR/agents/adversarial-reviewer.md.bak"
            fix "adversarial-reviewer: fixed model to $ADVERSARIAL_PIN"
            FIXES=$((FIXES + 1))
        fi
        # Content markers that mean "this agent predates a contract it must carry".
        # Each refresh rewrites the file from the template, so the markers are
        # checked together and the file is regenerated at most once.
        #   reviewed-files    — scope directive (v4.7.10+)
        #   guard-spec-blind  — spec-blindness enforcement (v7.0+); without it
        #                       the decontextualisation contract is intent only
        #   omitClaudeMd: true — CLAUDE.md-blindness (v7.2; CC ≥ 2.1.271 honours it,
        #                       older CC ignores the field = today's behaviour): the
        #                       reviewer must not read the project's own instructions
        #                       and conventions either — it judges the diff, not the intent
        MISSING_MARKER=""
        grep -q 'reviewed-files' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null \
            || MISSING_MARKER=".reviewed-files scope directive"
        grep -q 'guard-spec-blind' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null \
            || MISSING_MARKER="${MISSING_MARKER:+$MISSING_MARKER + }spec-blind guard"
        grep -qE '^omitClaudeMd:[[:space:]]*true' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null \
            || MISSING_MARKER="${MISSING_MARKER:+$MISSING_MARKER + }omitClaudeMd (CLAUDE.md-blind)"
        if [ -n "$MISSING_MARKER" ]; then
            if [ -f "$APD_PLUGIN_ROOT/templates/adversarial-reviewer-template.md" ]; then
                # Rule 0: the refresh REPLACES the file — keep what was there (first backup per version wins).
              if ! _init_backup "$CLAUDE_DIR/agents/adversarial-reviewer.md" "$CLAUDE_DIR/agents/adversarial-reviewer.md.bak.pre-v$APD_VER"; then
                warn "adversarial-reviewer: missing $MISSING_MARKER, but the backup could not be written — NOT refreshed (never without a backup)"
              else
                # The template carries the DEFAULT model/effort. When a profile is
                # declared, the profile owns those lines — refreshing blind would
                # silently revert a burn/eco project to sonnet on the next
                # session-start init (the v6.16.1 no-revert contract).
                PREV_MODEL=$(grep -m1 '^model:' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null || true)
                PREV_EFFORT=$(grep -m1 '^effort:' "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null || true)

                if _init_render_agent "$APD_PLUGIN_ROOT/templates/adversarial-reviewer-template.md" "$CLAUDE_DIR/agents/adversarial-reviewer.md"; then

                # Restore the profile-applied pin only if the profile actually
                # owns this role; otherwise the template pin IS the intent.
                if _profile_owns adversarial; then
                    [ -n "$PREV_MODEL" ] && sed -i.bak "s|^model:.*|$PREV_MODEL|" "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null
                    [ -n "$PREV_EFFORT" ] && sed -i.bak "s|^effort:.*|$PREV_EFFORT|" "$CLAUDE_DIR/agents/adversarial-reviewer.md" 2>/dev/null
                    rm -f "$CLAUDE_DIR/agents/adversarial-reviewer.md.bak"
                fi

                fix "adversarial-reviewer: refreshed from template (added $MISSING_MARKER; previous copy kept as $(basename "$INIT_BAK"))"
                FIXES=$((FIXES + 1))
                fi   # written
              fi   # backup exists
            fi
        fi
    else
        if [ -f "$APD_PLUGIN_ROOT/templates/adversarial-reviewer-template.md" ]; then
            if _init_render_agent "$APD_PLUGIN_ROOT/templates/adversarial-reviewer-template.md" "$CLAUDE_DIR/agents/adversarial-reviewer.md"; then
                fix "Created adversarial-reviewer.md (${ADVERSARIAL_PIN:-template pin}/max, context-free review)"
                FIXES=$((FIXES + 1))
            fi
        fi
    fi

    # --- supervisor agent (v6.30 — frontier final review, profile-gated) ---
    # No hardcoded model repair here (v6.16.1 lesson): the template pins the
    # frontier tier and `apd profile` owns rewrites where a supervisor row
    # exists. Init only scaffolds the file + surfaces a broken memory contract.
    if [ -f "$CLAUDE_DIR/agents/supervisor.md" ]; then
        if grep -q 'memory: none' "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null; then
            ok "supervisor (final-review layer, memory: none)"
        else
            warn "supervisor: missing 'memory: none' (decontextualization contract)"
        fi
        # v7.1 content marker: `### Notes` — findings carry the question they
        # answer, notes need no disposition. A copy without it still files every
        # observation as a finding (the SUPERVISION:8:7:1 pattern). Same refresh
        # idiom as the adversarial markers: profile-managed model/effort survive.
        if ! grep -q '### Notes' "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null \
           && [ -f "$APD_PLUGIN_ROOT/templates/supervisor-template.md" ]; then
            PREV_MODEL=$(grep -m1 '^model:' "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null || true)
            PREV_EFFORT=$(grep -m1 '^effort:' "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null || true)
            # The project copy may carry local edits; a rewrite that drops them is
            # a deletion. Keep the first pre-refresh copy beside it (first-wins,
            # never overwritten) and name it in the fix line.
            if ! _init_backup "$CLAUDE_DIR/agents/supervisor.md" "$CLAUDE_DIR/agents/supervisor.md.bak.pre-v7.1"; then
                warn "supervisor: no Question/Notes contract, but the backup could not be written — NOT refreshed (never without a backup)"
            elif _init_render_agent "$APD_PLUGIN_ROOT/templates/supervisor-template.md" "$CLAUDE_DIR/agents/supervisor.md"; then
            if _profile_owns supervisor; then
                [ -n "$PREV_MODEL" ] && sed -i.bak "s|^model:.*|$PREV_MODEL|" "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null
                [ -n "$PREV_EFFORT" ] && sed -i.bak "s|^effort:.*|$PREV_EFFORT|" "$CLAUDE_DIR/agents/supervisor.md" 2>/dev/null
                rm -f "$CLAUDE_DIR/agents/supervisor.md.bak"
            fi
            fix "supervisor: refreshed from template (added the Question/Notes contract; previous copy kept as $(basename "$INIT_BAK"))"
            FIXES=$((FIXES + 1))
            fi   # backup exists and the agent was written
        fi
    else
        if [ -f "$APD_PLUGIN_ROOT/templates/supervisor-template.md" ]; then
            if _init_render_agent "$APD_PLUGIN_ROOT/templates/supervisor-template.md" "$CLAUDE_DIR/agents/supervisor.md"; then
                fix "Created supervisor.md (frontier final review — every profile, Full mode)"
                FIXES=$((FIXES + 1))
            fi
        fi
    fi

    # --- builder charter (v7.0) ---------------------------------------------
    # Builders are the least-educated role and the most consequential one: the
    # orchestrator gets a mandatory operating manual, the supervisor a charter,
    # the adversarial reviewer a template that explains its own blindness — while
    # the agent that actually writes the code got a FORBIDDEN list and a scope.
    # The charter carries what only a builder needs and nothing else tells it:
    # who judges the diff (including a reader that CANNOT see the spec), which
    # paths raise the bar, that a claim needs an executed red-green proof, that
    # the regression surface is its obligation, and that the shell is not a way
    # around scope.
    #
    # Builder agents are project-authored (their scope is the project's), so init
    # cannot regenerate them from the template — it inserts the block instead,
    # once, keyed on a machine marker rather than on prose. Only agents that can
    # WRITE get it; the reviewer, adversarial and supervisor roles carry their own
    # contracts and would be diluted by this one.
    CHARTER_MARK="<!-- apd:builder-charter -->"
    CHARTER_SRC="$APD_PLUGIN_ROOT/templates/agent-template.md"
    if [ -d "$CLAUDE_DIR/agents" ] && [ -f "$CHARTER_SRC" ]; then
        CHARTER_ADDED=0
        for _ag in "$CLAUDE_DIR"/agents/*.md; do
            [ -f "$_ag" ] || continue
            case "$(basename "$_ag")" in apd-verify-*) continue ;; esac
            # Everything else — is this a writable agent, is the block already
            # there, where does it go — is decided by the parser below, which is
            # the only thing here that understands frontmatter and code fences.
            python3 - "$_ag" "$CHARTER_SRC" <<'PYCHARTER' || continue
import sys
agent_path, tmpl_path = sys.argv[1], sys.argv[2]
MARK = "<!-- apd:builder-charter -->"
tmpl = open(tmpl_path, encoding="utf-8").read()
start = tmpl.find(MARK)
if start == -1:
    sys.exit(1)
# The block runs to the next top-level heading that is not part of the charter.
rest = tmpl[start:]
end = rest.find("\n## Stack")
block = (rest if end == -1 else rest[:end]).rstrip() + "\n\n"

# `newline=""` on BOTH ends. Python's default text mode translates CRLF to LF on
# read and never puts it back, so inserting one block rewrote every line ending
# in the file — a whole-file diff for a two-line change, on the one platform
# where that is the normal ending. Measured: an 8-line CRLF agent came back with
# 0. Work in LF internally, restore whatever the file used on write.
raw = open(agent_path, encoding="utf-8", newline="").read()
eol = "\r\n" if "\r\n" in raw else "\n"
body = raw.replace("\r\n", "\n")
lines = body.split("\n")
# v7.3 (audit-730 F8): "already carries the charter" means a marker OUTSIDE a
# code fence. A marker quoted in an example used to count, so that builder
# never received a charter at all.
# (pass 2, N2) …but a marker inside a fence that never CLOSES counts: for an
# unterminated fence the insert position below is the end of the file, i.e.
# inside it — skipping that marker appended one more block on every init.
_fence = None
_in_fence_mark = False
for _l in lines:
    _s = _l.lstrip()
    if _fence is None:
        if _s.startswith("```") or _s.startswith("~~~"):
            _fence = _s[:3]
            _in_fence_mark = False
        elif MARK in _l:
            sys.exit(2)              # already carries the charter
    elif _s.startswith(_fence):
        _fence = None
    elif MARK in _l:
        _in_fence_mark = True
if _fence is not None and _in_fence_mark:
    sys.exit(2)                      # the block sits in the unterminated fence

# --- frontmatter bounds -----------------------------------------------------
fm_end = 0
if lines and lines[0].strip() == "---":
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            fm_end = i + 1
            break

# --- is this a WRITABLE agent? ----------------------------------------------
# Scoped to the frontmatter on purpose: a prose line or a code sample in the
# BODY that happens to start with `tools:` is not a declaration, and treating
# it as one put the charter into files that are not agents at all.
tools_writable = False
for i in range(0, fm_end):
    l = lines[i].strip()
    if l.lower().startswith("tools:") and "write" in l.lower():
        tools_writable = True
        break
if not tools_writable:
    sys.exit(3)

# --- where the block goes ---------------------------------------------------
# Before the first top-level section of the BODY — but a `## ` inside a fenced
# code block is NOT a section. Inserting there corrupts the user's example AND
# renders the charter as literal code, so the agent reads it as a sample rather
# than as instruction: the block is present and silently inert, which is worse
# than absent because nothing looks wrong.
ins = len(lines)
fence = None
for i in range(fm_end, len(lines)):
    s = lines[i].lstrip()
    if fence is None:
        if s.startswith("```") or s.startswith("~~~"):
            fence = s[:3]
            continue
        if lines[i].startswith("## "):
            ins = i
            break
    else:
        if s.startswith(fence):
            fence = None
if fence is not None:
    # Unterminated fence: everything after it is ambiguous, so append at the end
    # rather than guess a boundary inside it.
    ins = len(lines)

out = "\n".join(lines[:ins]).rstrip() + "\n\n" + block + "\n".join(lines[ins:]).lstrip("\n")
open(agent_path, "w", encoding="utf-8", newline="").write(out.replace("\n", eol))
PYCHARTER
            # reached only when the inserter exited 0 (`|| continue` above): a block was written
            CHARTER_ADDED=$((CHARTER_ADDED + 1))
        done
        if [ "$CHARTER_ADDED" -gt 0 ]; then
            fix "Builder charter added to $CHARTER_ADDED agent(s) — how the diff is judged, where the bar rises, red-green proof"
            FIXES=$((FIXES + 1))
        fi
    fi

    # --- Clean APD-VERIFY pollution from pipeline-metrics.log (one-time) ---
    if [ -f "$MEMORY_DIR/pipeline-metrics.log" ]; then
        if grep -q '^[0-9]*|APD-VERIFY-' "$MEMORY_DIR/pipeline-metrics.log" 2>/dev/null; then
            POLLUTED=$(grep -c '^[0-9]*|APD-VERIFY-' "$MEMORY_DIR/pipeline-metrics.log" 2>/dev/null || echo 0)
            grep -v '^[0-9]*|APD-VERIFY-' "$MEMORY_DIR/pipeline-metrics.log" > "$MEMORY_DIR/pipeline-metrics.log.tmp" && \
                mv "$MEMORY_DIR/pipeline-metrics.log.tmp" "$MEMORY_DIR/pipeline-metrics.log"
            fix "pipeline-metrics.log: removed $POLLUTED APD-VERIFY test pollution entries"
            FIXES=$((FIXES + 1))
        fi
    fi

    # --- maxTurns REMOVED (v6.31), and left alone since ---
    # Agent-frontmatter maxTurns was a no-op on CC 2.1.204 (controlled test
    # 2026-07-09), so the repair block that added/bumped it was dropped as
    # cosmetic. Re-measured 2026-10-01 on 2.1.286: CC enforces it again
    # (partial output + SendMessage resume). APD still ships none — the dispatch
    # budget sizes a task — and init never writes or strips the field: a project
    # that set it did so on purpose. Codex `max_turns` is a different runtime.

    # --- Agent stale paths: bin/core/ → bin/adapter/cc/ ---
    for agent_file in "$CLAUDE_DIR/agents"/*.md; do
        [ -f "$agent_file" ] || continue
        AGENT_NAME=$(basename "$agent_file" .md)
        if grep -q 'bin/core/guard-scope\|bin/core/guard-bash-scope\|bin/core/guard-git\|bin/core/guard-secrets' "$agent_file" 2>/dev/null; then
            echo "  ${YELLOW}${B}STALE PATH:${R} $AGENT_NAME references bin/core/ guard paths — updating to bin/adapter/cc/" >&2
            # Single sed invocation with all four substitutions — one .bak to clean up,
            # atomic per-file (either all four apply or none).
            sed -i.bak \
                -e 's|bin/core/guard-scope|bin/adapter/cc/guard-scope|g' \
                -e 's|bin/core/guard-bash-scope|bin/adapter/cc/guard-bash-scope|g' \
                -e 's|bin/core/guard-git|bin/adapter/cc/guard-git|g' \
                -e 's|bin/core/guard-secrets|bin/adapter/cc/guard-secrets|g' \
                "$agent_file" && rm -f "${agent_file}.bak"
            fix "$AGENT_NAME: updated stale guard paths (core/ → adapter/cc/)"
            FIXES=$((FIXES + 1))
        fi
    done

    # Safety net: any leftover .bak files from interrupted sed runs in this or
    # a prior apd-init session. sed on macOS requires -i.bak so a partial failure
    # can leave these; clean them now.
    rm -f "$CLAUDE_DIR/agents"/*.bak 2>/dev/null || true

    # --- workflow.md ---
    # v7.1.6: the project's copy descends from a SHIPPED copy that init records
    # in .apd/.workflow.md.shipped. Whenever the framework's file changes (any
    # bump that edits rules/workflow.md — v7.1.3 did, and every project drifted
    # with no marker to fire on) init merges the change into the project's copy
    # with `git merge-file` (base = the record, ours = the project's copy,
    # theirs = the new shipped file): local edits survive, a clean merge is
    # applied and backed up, a conflict leaves the copy untouched and says so.
    # The marker sweep runs first, in every state (list shared with
    # pipeline-audit-drift via lib/workflow-markers.sh). Before v7.1.6 a byte difference was reported by
    # `apd audit-drift` only — which nothing runs at session start — and init
    # printed "ok"; the v7.0.3 rationale (a per-stack table apd-setup asks the
    # orchestrator to write into section 7) described an instruction that the
    # skill never gave. Local edits are still honoured: by the merge, not by
    # leaving the file behind.
    # v7.3: the state machine itself lives in lib/shipped-sync.sh (`_shipped_sync`)
    # — the same code now carries the review agents, the builder charter,
    # principles.md and the Codex-side copies (below). What stays here is what
    # is workflow.md's own: the marker sweep and the wording of its recoveries.
    WF_SHIPPED="$APD_PLUGIN_ROOT/rules/workflow.md"
    WF_PROJECT="$CLAUDE_DIR/rules/workflow.md"
    _wf_stale_reason() {
        local wf_marker
        if [ ! -s "$WF_PROJECT" ]; then
            printf 'empty file'
        elif grep -q 'CLAUDE_PLUGIN_ROOT' "$WF_PROJECT" 2>/dev/null || grep -qF '.claude/.pipeline' "$WF_PROJECT" 2>/dev/null; then
            printf 'stale paths'
        else
            for wf_marker in ${WORKFLOW_MARKERS[@]+"${WORKFLOW_MARKERS[@]}"}; do
                if grep -q "$wf_marker" "$WF_SHIPPED" 2>/dev/null \
                   && ! grep -q "$wf_marker" "$WF_PROJECT" 2>/dev/null; then
                    printf "missing '%s' guidance" "$wf_marker"
                    break
                fi
            done
        fi
    }
    _ss_reset
    SS_LABEL="workflow.md"
    SS_SHIPPED="$WF_SHIPPED"; SS_PROJECT="$WF_PROJECT"
    SS_RECORD="$PROJECT_DIR/.apd/.workflow.md.shipped"
    SS_LOCK="$PROJECT_DIR/.apd/.workflow-merge.lock"
    SS_DISP_PROJECT=".claude/rules/workflow.md"; SS_DISP_RECORD=".apd/.workflow.md.shipped"
    SS_HANDMERGE="git merge-file -p .claude/rules/workflow.md .apd/.workflow.md.shipped '$WF_SHIPPED' > /tmp/workflow.merged (edit the <<<<<<< markers there), cp /tmp/workflow.merged .claude/rules/workflow.md, then cp '$WF_SHIPPED' .apd/.workflow.md.shipped"
    SS_MSG_CONFLICT="; or take the shipped file: cp '$WF_SHIPPED' .claude/rules/workflow.md (back it up first). /apd-setup step 5c walks through it"
    SS_MSG_NOGIT=" — see /apd-setup step 5c"
    SS_MSG_NORECORD="LOCAL EDITS to keep: cp '$WF_SHIPPED' .apd/.workflow.md.shipped (they become local, merged forward from now on — anything the framework changed before today stays unmerged and audit-drift keeps reporting the difference). An OLDER framework text: cp '$WF_SHIPPED' .claude/rules/workflow.md (back it up first). /apd-setup step 5c asks which"
    SS_STALE_FN=_wf_stale_reason
    # v7.3: with no record, a copy whose hash is a text the framework shipped
    # earlier is an unedited old copy — refreshed (backup kept). Projects set up
    # before v7.1.6 and never taken through step 5c stayed on the old rules:
    # four of eight local projects, 144–217 lines behind (measured 2026-10-03).
    SS_HISTORY_KEY=cc-workflow
    SS_CREATE=true
    _shipped_sync
    _ss_exclude_backups "$WF_PROJECT"   # v7.3.1: a backup beside a copy must not show up in git status

    fi   # CC_SIDE (agents, charter, workflow.md)

    # --- every other copy the framework ships into a project (v7.3) ---
    # The registry (lib/shipped-sync.sh) lists them; audit-drift reads the same
    # list. Until v7.3 each was written once, or refreshed only when a marker
    # was missing — so a release that changed a template reached no installed
    # project while APD_VERSION said it had (v7.2.4, measured on PLAZMA).
    SS_TMP=$(mktemp -d -t apd-shipped.XXXXXX 2>/dev/null || echo "")
    SS_AGENTS_CHANGED=0
    if [ -n "$SS_TMP" ] && [ -d "$SS_TMP" ]; then
        while IFS='|' read -r _ss_key _ss_kind _ss_tmpl _ss_rel; do
            [ -n "$_ss_key" ] || continue
            _ss_reset
            SS_SHIPPED="$SS_TMP/$_ss_key.md"
            SS_PIN_DEFAULTS="$APD_PLUGIN_ROOT/$_ss_tmpl"
            _ss_render "$_ss_kind" "$APD_PLUGIN_ROOT/$_ss_tmpl" "$PROJECT_DIR/$_ss_rel" "$SS_SHIPPED" || continue
            SS_LABEL="$_ss_rel"
            SS_PROJECT="$PROJECT_DIR/$_ss_rel"
            SS_RECORD=$(_ss_record_path "$_ss_key")
            # model:/effort: belong to `apd profile` and the pin repair above: the
            # record is compared with those two lines as the project has them NOW,
            # or every profile switch would read as a framework change
            SS_PIN_DEFAULTS="$APD_PLUGIN_ROOT/$_ss_tmpl"
            [ "$_ss_kind" = agent ] && SS_PINS_FROM="$PROJECT_DIR/$_ss_rel"
            SS_LOCK="$PROJECT_DIR/.apd/.shipped/.$_ss_key.lock"
            SS_DISP_PROJECT="$_ss_rel"; SS_DISP_RECORD=".apd/.shipped/$_ss_key.md"
            SS_HISTORY_KEY="$_ss_key"; SS_CANON_NAME=$(_ss_project_name "$_ss_kind"); SS_KIND="$_ss_kind"
            SS_HANDMERGE="git merge-file -p $_ss_rel .apd/.shipped/$_ss_key.md .apd/.shipped/$_ss_key.new.md > /tmp/$_ss_key.merged (edit the <<<<<<< markers there), cp /tmp/$_ss_key.merged $_ss_rel, then cp .apd/.shipped/$_ss_key.new.md .apd/.shipped/$_ss_key.md"
            SS_MSG_CONFLICT=" (.apd/.shipped/$_ss_key.new.md is the framework's text for this project). Or take the framework's text: cp .apd/.shipped/$_ss_key.new.md $_ss_rel (back the copy up first), then the same cp to the record"
            SS_MSG_NOGIT=" — install git, or take the framework's text: move $_ss_rel aside and run apd init"
            SS_MSG_NORECORD="No earlier shipped text is available as a merge base for it. It will not receive framework changes until a record exists: mkdir -p .apd/.shipped && cp <the framework text this copy was made from> .apd/.shipped/$_ss_key.md — or take the framework's text: move $_ss_rel aside and run apd init (current template: $APD_PLUGIN_ROOT/$_ss_tmpl)"
            _shipped_sync
            # a conflict: leave the framework's text for this project next to the record — the recipe names it
            if [ "$SS_RESULT" = conflict ]; then cp "$SS_SHIPPED" "$PROJECT_DIR/.apd/.shipped/$_ss_key.new.md" 2>/dev/null || true
            else rm -f "$PROJECT_DIR/.apd/.shipped/$_ss_key.new.md" 2>/dev/null || true; fi
            case "$_ss_kind:$SS_RESULT" in
                agent:refreshed|agent:merged) SS_AGENTS_CHANGED=$((SS_AGENTS_CHANGED + 1)) ;;
            esac
            _ss_exclude_backups "$PROJECT_DIR/$_ss_rel"
        done < <(_ss_registry)

        # --- the builder charter: a block inside project-owned builder agents ---
        if _ss_charter_shipped "$SS_TMP/charter.shipped" && [ -d "$CLAUDE_DIR/agents" ]; then
            for _ag in "$CLAUDE_DIR"/agents/*.md; do
                [ -f "$_ag" ] || continue
                case "$(basename "$_ag")" in apd-verify-*) continue ;; esac
                _ag_name=$(basename "$_ag" .md)
                if ! _ss_charter_extract "$_ag" "$SS_TMP/charter.$_ag_name"; then
                    # no block, a marker only inside a code fence, or more than one block
                    _ch_n=$(grep -cF "$SS_CHARTER_MARK" "$_ag" 2>/dev/null) || true
                    [ "${_ch_n:-0}" -gt 1 ] && warn "builder charter ($_ag_name): $_ch_n charter markers in .claude/agents/$_ag_name.md — the block is not synced until there is exactly one"
                    continue
                fi
                if [ ! -w "$_ag" ]; then
                    cmp -s "$SS_TMP/charter.$_ag_name" "$SS_TMP/charter.shipped" || warn "builder charter ($_ag_name): .claude/agents/$_ag_name.md is not writable — the charter block was not checked against the framework's"
                    continue
                fi
                _ss_reset
                SS_LABEL="builder charter ($_ag_name)"
                SS_SHIPPED="$SS_TMP/charter.shipped"; SS_PROJECT="$SS_TMP/charter.$_ag_name"
                SS_RECORD=$(_ss_record_path "charter-$_ag_name")
                SS_LOCK="$PROJECT_DIR/.apd/.shipped/.charter-$_ag_name.lock"
                SS_DISP_PROJECT="the charter block of .claude/agents/$_ag_name.md"; SS_DISP_RECORD=".apd/.shipped/charter-$_ag_name.md"
                SS_HISTORY_KEY="charter"; SS_KIND=plain
                SS_BACKUP_SRC="$_ag"
                SS_HANDMERGE="edit the block that starts at '$SS_CHARTER_MARK' in .claude/agents/$_ag_name.md against the one in $APD_PLUGIN_ROOT/templates/agent-template.md"
                SS_MSG_CONFLICT="; then delete .apd/.shipped/charter-$_ag_name.md so init records the new text on its next run"
                SS_MSG_NOGIT=" — install git, or copy the block by hand from $APD_PLUGIN_ROOT/templates/agent-template.md"
                SS_MSG_NORECORD="The block is not one the framework shipped in an earlier version, so it was edited here. It will not receive framework changes; to take the framework's block, replace it by hand from $APD_PLUGIN_ROOT/templates/agent-template.md"
                # the record is committed only AFTER the block is back in the agent
                # (SS_DEFER_RECORD → <record>.pending): a kill in between then leaves
                # the old record with the old block, which the next init simply redoes
                _ch_rec=$(_ss_record_path "charter-$_ag_name")
                rm -f "$_ch_rec.pending" "$_ag".charter.[0-9]* 2>/dev/null   # leftovers of a killed run
                SS_DEFER_RECORD=true
                _shipped_sync
                case "$SS_RESULT" in
                    refreshed|merged)
                        if _ss_charter_splice "$_ag" "$SS_TMP/charter.$_ag_name"; then
                            [ -f "$_ch_rec.pending" ] && mv -f "$_ch_rec.pending" "$_ch_rec" 2>/dev/null
                            SS_AGENTS_CHANGED=$((SS_AGENTS_CHANGED + 1))
                        else
                            rm -f "$_ch_rec.pending"
                            warn "builder charter ($_ag_name): the new block could not be written into .claude/agents/$_ag_name.md — left as it was; it will be retried"
                        fi ;;
                    *)
                        # nothing to splice (record started, or nothing changed): the pending record is the record
                        [ -f "$_ch_rec.pending" ] && mv -f "$_ch_rec.pending" "$_ch_rec" 2>/dev/null ;;
                esac
                _ss_exclude_backups "$_ag"
            done
        fi
        rm -rf "$SS_TMP"
        _ss_exclude_transients
        if [ "$SS_AGENTS_CHANGED" -gt 0 ]; then
            # Agent definitions are read when a session starts: the running one
            # keeps the text it loaded.
            warn "$SS_AGENTS_CHANGED agent text(s) were updated from the framework — they take effect in the NEXT session (agent definitions are cached at session start)"
        fi
    else
        warn "shipped-copy sync skipped: no temp directory (TMPDIR?)"
    fi

if [ "$CC_SIDE" = true ]; then   # settings, legacy paths, memory, .apd-version — CC-native
    # --- settings.json: remove stale SessionStart hooks ---
    # Plugin hooks.json handles SessionStart via ${CLAUDE_PLUGIN_ROOT}.
    # Old project setups may override it with hardcoded paths that no longer exist.
    if [ -f "$CLAUDE_DIR/settings.json" ] && grep -q '"SessionStart"' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
        tmp=$(mktemp)
        python3 -c "
import json, sys
with open('$CLAUDE_DIR/settings.json') as f:
    data = json.load(f)
removed = False
if 'hooks' in data and 'SessionStart' in data['hooks']:
    del data['hooks']['SessionStart']
    removed = True
    if not data['hooks']:
        del data['hooks']
if removed:
    with open('$CLAUDE_DIR/settings.json', 'w') as f:
        json.dump(data, f, indent=2)
        f.write('\n')
    sys.exit(0)
sys.exit(1)
" 2>/dev/null
        if [ $? -eq 0 ]; then
            fix "Removed stale SessionStart hook from settings.json (plugin handles it)"
            FIXES=$((FIXES + 1))
        else
            ok "No stale SessionStart hooks"
        fi
    else
        ok "No stale SessionStart hooks"
    fi

    # --- settings.json: superpowers disabled ---
    if [ -f "$CLAUDE_DIR/settings.json" ]; then
        if grep -q '"superpowers@claude-plugins-official"' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
            ok "superpowers disabled in settings"
        else
            # Add superpowers disable to enabledPlugins
            if grep -q '"enabledPlugins"' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
                sed -i.bak '/"enabledPlugins".*{/a\
    "superpowers@claude-plugins-official": false,' "$CLAUDE_DIR/settings.json" 2>/dev/null && rm -f "$CLAUDE_DIR/settings.json.bak"
            else
                # Add enabledPlugins section before closing brace
                tmp=$(mktemp)
                awk '
                /^}$/ {
                    print "  ,\"enabledPlugins\": {"
                    print "    \"superpowers@claude-plugins-official\": false"
                    print "  }"
                    print "}"
                    next
                }
                { print }
                ' "$CLAUDE_DIR/settings.json" > "$tmp" && mv "$tmp" "$CLAUDE_DIR/settings.json"
            fi
            fix "Disabled superpowers in settings.json"
            FIXES=$((FIXES + 1))
        fi

        # Attribution
        if grep -q '"attribution"' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
            ok "attribution configured"
        else
            tmp=$(mktemp)
            awk '
            /^}$/ {
                print "  ,\"attribution\": {"
                print "    \"commit\": \"\","
                print "    \"pr\": \"\""
                print "  }"
                print "}"
                next
            }
            { print }
            ' "$CLAUDE_DIR/settings.json" > "$tmp" && mv "$tmp" "$CLAUDE_DIR/settings.json"
            fix "Added attribution (empty, no AI signatures)"
            FIXES=$((FIXES + 1))
        fi

        # Permissions — auto-allow memory + pipeline writes + apd commands.
        # v6.16.1: the probe must also include a DENY sentinel — pre-v6.16.1 it
        # checked allow-side only, so projects that already had the allow entries
        # (any pre-v6.10 install) never re-entered the merge and stayed at 4/8
        # deny patterns forever ("re-run setup" recovery was a no-op for them).
        # v6.36.1: sentinels are Edit(...) — on CC 2.1.208+ Edit(path) covers ALL
        # file-editing tools (Write/Edit/MultiEdit/NotebookEdit), so APD emits
        # Edit-only. A legacy APD Write(...) allow twin present also triggers
        # repair: the merge strips it (inert on 2.1.208+ → startup "use Edit"
        # warnings). See CC permissions min-version 2.1.208.
        # v7.0.3: there is no bash pre-probe any more. It kept its OWN list of
        # four sentinels, separate from the required lists below, so every time
        # the required list grew the probe stayed behind and existing projects
        # never re-entered the merge. That is exactly how it failed twice: the
        # v6.10 deny expansion (fixed in v6.16.1 by adding a deny sentinel) and
        # again in v6.30/v7.0, when the allow list went from the pre-v6.7 trio to
        # seven pipeline files — measured on Bambi 2026-07-26, where the four
        # sentinels all matched and `.guide-marker`, `.adversarial-rationale.md`
        # and both supervision files never arrived, so the gates the framework
        # MANDATES prompted on paths it had promised to pre-approve.
        # The merge below is now the single source of truth: it computes the
        # result, writes only when it differs, and exits 1 when nothing changed.
        PERM_RC=0
        PERM_OUT=$(python3 -c "
import json, sys
with open('$CLAUDE_DIR/settings.json') as f:
    s = json.load(f)
required_allow = [
    'Edit(.claude/memory/**)', 'Edit(**/.claude/memory/**)',
    'Edit(.apd/pipeline/spec-card.md)', 'Edit(.apd/pipeline/implementation-plan.md)',
    # Every file guard-pipeline-state lets the orchestrator write must be
    # pre-approved here, or the gates it MUST satisfy (rationale at the verifier,
    # .guide-marker at the spec advance) prompt on a path the framework mandates.
    # This list carried only the pre-v6.7 trio for ~30 minor versions.
    'Edit(.apd/pipeline/.adversarial-summary)', 'Edit(.apd/pipeline/.adversarial-rationale.md)',
    'Edit(.apd/pipeline/.supervision-summary)', 'Edit(.apd/pipeline/.supervision-rationale.md)',
    'Edit(.apd/pipeline/.guide-marker)',
    'Edit(**/.apd/pipeline/spec-card.md)', 'Edit(**/.apd/pipeline/implementation-plan.md)',
    'Edit(**/.apd/pipeline/.adversarial-summary)', 'Edit(**/.apd/pipeline/.adversarial-rationale.md)',
    'Edit(**/.apd/pipeline/.supervision-summary)', 'Edit(**/.apd/pipeline/.supervision-rationale.md)',
    'Edit(**/.apd/pipeline/.guide-marker)',
    'Bash(bash .claude/bin/apd *)', 'Bash(bash .claude/bin/apd pipeline *)'
]
required_deny = [
    # v6.5+ slash-prefixed (relative-path glob)
    'Bash(mkdir */.apd/pipeline/*)', 'Bash(mkdir -p */.apd/pipeline/*)',
    'Bash(mkdir */.apd/pipeline)', 'Bash(mkdir -p */.apd/pipeline)',
    # v6.10+ bare-dir (literal path without leading glob) — closes bypass vector
    # where 'mkdir .apd/pipeline' is run from project root without slash prefix.
    # Pre-v6.10 re-inits left projects with only 4 patterns; v6.10 audit drift
    # detection flags this and recommends re-run of apd-setup.
    'Bash(mkdir .apd/pipeline/*)', 'Bash(mkdir -p .apd/pipeline/*)',
    'Bash(mkdir .apd/pipeline)', 'Bash(mkdir -p .apd/pipeline)'
]
apd_write_twins = {
    'Write(.claude/memory/**)', 'Write(**/.claude/memory/**)',
    'Write(.apd/pipeline/spec-card.md)', 'Write(.apd/pipeline/implementation-plan.md)',
    'Write(.apd/pipeline/.adversarial-summary)',
    'Write(**/.apd/pipeline/spec-card.md)', 'Write(**/.apd/pipeline/implementation-plan.md)',
    'Write(**/.apd/pipeline/.adversarial-summary)',
}
# CC 2.1.208+: Edit(path) covers all file-editing tools, so strip legacy APD
# Write(...) allow twins — otherwise they emit startup 'use Edit(path)' warnings.
existing_allow = [x for x in s.get('permissions', {}).get('allow', []) if x not in apd_write_twins]
existing_deny = s.get('permissions', {}).get('deny', [])
before_allow = s.get('permissions', {}).get('allow', [])
before_deny = list(existing_deny)
merged_allow = list(dict.fromkeys(existing_allow + required_allow))
merged_deny = list(dict.fromkeys(existing_deny + required_deny))
# Nothing to do — say so by exit code instead of by a separate probe that can
# fall behind this list. Code 3, NOT 1: CPython exits 1 on any uncaught
# exception and this call discards stderr, so no-change and crashed-on-a-
# malformed-settings.json would be the same signal — and the crash would be
# reported as a green OK on exactly the projects the merge exists to repair.
if merged_allow == before_allow and merged_deny == before_deny:
    sys.exit(3)
added = len([x for x in merged_allow if x not in before_allow]) + len([x for x in merged_deny if x not in before_deny])
stripped = len([x for x in before_allow if x in apd_write_twins])
s.setdefault('permissions', {})['allow'] = merged_allow
s.setdefault('permissions', {})['deny'] = merged_deny
# Atomic: every other settings.json writer in this script goes through
# mktemp + mv. An interrupted in-place write leaves a truncated file, and a
# truncated file is exactly the input the merge cannot parse.
import os, tempfile
_dst = '$CLAUDE_DIR/settings.json'
_fd, _tmp = tempfile.mkstemp(dir=os.path.dirname(_dst) or '.', prefix='.settings.', suffix='.tmp')
with os.fdopen(_fd, 'w') as f:
    json.dump(s, f, indent=2, ensure_ascii=False)
    f.write('\n')
os.replace(_tmp, _dst)
print('%d added, %d legacy Write twin(s) stripped' % (added, stripped))
" 2>/dev/null) || PERM_RC=$?
        if [ "$PERM_RC" -eq 0 ]; then
            fix "Updated permissions (pipeline + apd commands) — $PERM_OUT"
            FIXES=$((FIXES + 1))
        elif [ "$PERM_RC" -eq 3 ]; then
            ok "permissions (pipeline + apd commands)"
        elif [ "$PERM_RC" -eq 127 ]; then
            warn "Could not update permissions (python3 required)"
        else
            # Any other code is the merge dying — almost always an unparseable
            # settings.json (merge conflict markers, truncated write). Never
            # report that as OK: the pipeline files stay unapproved and the
            # gates the framework mandates will prompt.
            warn "Could not update permissions — settings.json may be invalid JSON (run: python3 -m json.tool $CLAUDE_DIR/settings.json)"
        fi
    fi

    # --- Stale paths and legacy directories ---
    # Remove legacy script directories that confuse orchestrator
    for old_dir in "$CLAUDE_DIR/scripts.old" "$CLAUDE_DIR/scripts"; do
        if [ -d "$old_dir" ] && [ -f "$old_dir/pipeline-advance.sh" -o -f "$old_dir/guard-git.sh" ]; then
            rm -rf "$old_dir"
            fix "Removed legacy $(basename "$old_dir")/ directory"
            FIXES=$((FIXES + 1))
        fi
    done

    # Check for stale pipeline-advance references in project files
    STALE_FILES=""
    for check_file in "$CLAUDE_DIR/rules/workflow.md" "$PROJECT_DIR/CLAUDE.md" "$CLAUDE_DIR/memory/MEMORY.md"; do
        if [ -f "$check_file" ] && grep -qE 'pipeline-advance\.sh|scripts/pipeline-advance|bin/core/pipeline-advance' "$check_file" 2>/dev/null; then
            STALE_FILES="${STALE_FILES}$(basename "$check_file"), "
        fi
    done
    if [ -n "$STALE_FILES" ]; then
        warn "Stale pipeline-advance references in: ${STALE_FILES%, }"
        echo "    ${D}Correct command: bash .claude/bin/apd pipeline <command>${R}"
        [ "$QUICK" = false ] && FIXES=$((FIXES + 1))
    fi

    # --- Pipeline directory migration (.claude/.pipeline → .apd/pipeline) ---
    if [ -d "$CLAUDE_DIR/.pipeline" ]; then
        mkdir -p "$PROJECT_DIR/.apd/pipeline"
        # Move any existing state files
        if ls "$CLAUDE_DIR/.pipeline"/* 1>/dev/null 2>&1; then
            cp -a "$CLAUDE_DIR/.pipeline"/. "$PROJECT_DIR/.apd/pipeline/" 2>/dev/null
        fi
        rm -rf "$CLAUDE_DIR/.pipeline"
        fix "Migrated .claude/.pipeline/ → .apd/pipeline/"
        FIXES=$((FIXES + 1))
    fi
    # Ensure .apd/pipeline directory exists
    mkdir -p "$PROJECT_DIR/.apd/pipeline"

    # Update .gitignore: old entry → new entry
    if [ -f "$PROJECT_DIR/.gitignore" ]; then
        if grep -qF '.claude/.pipeline/' "$PROJECT_DIR/.gitignore" 2>/dev/null; then
            sed -i.bak 's|\.claude/\.pipeline/|.apd/pipeline/|g' "$PROJECT_DIR/.gitignore" && rm -f "$PROJECT_DIR/.gitignore.bak"
            fix "Updated .gitignore: .claude/.pipeline/ → .apd/pipeline/"
            FIXES=$((FIXES + 1))
        elif ! grep -qF '.apd/pipeline/' "$PROJECT_DIR/.gitignore" 2>/dev/null; then
            echo '.apd/pipeline/' >> "$PROJECT_DIR/.gitignore"
            fix "Added .apd/pipeline/ to .gitignore"
            FIXES=$((FIXES + 1))
        fi
    fi

    # Update old permission patterns in settings.json
    if [ -f "$CLAUDE_DIR/settings.json" ] && grep -qF '.pipeline/' "$CLAUDE_DIR/settings.json" 2>/dev/null; then
        sed -i.bak 's|\.claude/\.pipeline/|.apd/pipeline/|g; s|\*\*/\.pipeline/|**/.apd/pipeline/|g; s|mkdir \*/\.pipeline|mkdir */.apd/pipeline|g; s|Write(\.pipeline/|Edit(.apd/pipeline/|g; s|Edit(\.pipeline/|Edit(.apd/pipeline/|g' "$CLAUDE_DIR/settings.json" && rm -f "$CLAUDE_DIR/settings.json.bak"
        fix "Updated permission patterns in settings.json"
        FIXES=$((FIXES + 1))
    fi

    # --- Memory files ---
    for file in MEMORY.md status.md session-log.md; do
        if [ -f "$CLAUDE_DIR/memory/$file" ]; then
            ok "memory/$file"
        else
            mkdir -p "$CLAUDE_DIR/memory"
            touch "$CLAUDE_DIR/memory/$file"
            fix "Created memory/$file"
            FIXES=$((FIXES + 1))
        fi
    done

    # --- .apd-version ---
    CURRENT_VER=$(cat "$CLAUDE_DIR/.apd-version" 2>/dev/null | tr -d '[:space:]')
    PLUGIN_VER="$APD_VER"
    if [ "$CURRENT_VER" = "$PLUGIN_VER" ]; then
        ok ".apd-version ($CURRENT_VER)"
    else
        echo "$PLUGIN_VER" > "$CLAUDE_DIR/.apd-version"
        fix "Updated .apd-version: $CURRENT_VER → $PLUGIN_VER"
        FIXES=$((FIXES + 1))
    fi
fi   # CC_SIDE
fi

# ===========================================================
# CODEX ADAPTER — auto-run if .codex/ already exists
# Users who run Codex alongside CC will have a .codex/ dir; we register
# the MCP server + sandbox profiles + hooks.json for them here.
# Absent .codex/, do nothing — users bootstrap manually via
# `bash $APD_PLUGIN_ROOT/bin/adapter/cdx/install-codex-config`
# ===========================================================
if [ -d "$PROJECT_DIR/.codex" ]; then
    echo ""
    section "Codex adapter"
    CODEX_INIT="$APD_PLUGIN_ROOT/bin/adapter/cdx/install-codex-config"
    if [ -x "$CODEX_INIT" ]; then
        CODEX_OUT=$(bash "$CODEX_INIT" "$PROJECT_DIR" 2>&1 || true)
        echo "$CODEX_OUT" | sed 's/^/  /'
        # v7.3.1 (audit-731 F2): the installer keeps `.codex/hooks.json.bak.<epoch>`
        # and `.codex/config.toml.bak.<epoch>` when it rewrites those files — the
        # same untracked backup in a project that commits `.codex/`
        _ss_exclude_backups "$PROJECT_DIR/.codex/hooks.json"
        _ss_exclude_backups "$PROJECT_DIR/.codex/config.toml"
        if echo "$CODEX_OUT" | grep -qE '^\[wrote\]'; then
            FIXES=$((FIXES + 1))
        fi
    else
        warn "Codex init script missing at $CODEX_INIT"
    fi
fi

# ===========================================================
# SUMMARY
# ===========================================================
echo ""
if [ "$FIXES" -gt 0 ]; then
    echo "  ${G}${FIXES} fix(es) applied.${R}"
else
    echo "  ${B}Everything up to date.${R}"
fi
echo ""

# Run verify-apd (skip in quick mode)
if [ "$QUICK" = true ]; then
    [ "$FIXES" -gt 0 ] && echo "  ${D}(quick mode: $FIXES fix(es) applied)${R}"
    exit 0
fi
# v7.3.2: `--no-e2e`. Init repairs configuration; it has no business driving a
# synthetic task through the project's pipeline directory, which the full check
# does whenever that directory looks idle. The end-to-end test stays one
# explicit command away.
echo "  Running verification (static + guards; end-to-end test: apd verify)..."
echo ""
bash "$SCRIPT_DIR/verify-apd" --no-e2e
